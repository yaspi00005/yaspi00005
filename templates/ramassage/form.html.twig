{% extends 'base.html.twig' %}

{% block title %}{{ ramassage.id ? 'Ramassage chez ' ~ ramassage.client.nomComplet : 'Planifier un ramassage' }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-xl-7">
        <div class="card">
            <div class="card-header"><h4 class="card-title">{{ block('title') }}</h4></div>
            <div class="card-body">
                {% if ramassage.id and ramassage.statut.value == 'demande' %}
                <div class="alert alert-primary d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span><i class="fas fa-globe me-1"></i> Demande reçue sur le site le {{ ramassage.createdAt|date('d/m/Y à H:i') }} : appelez {{ ramassage.client.nomComplet }} au <a href="tel:{{ ramassage.client.telephone }}">{{ ramassage.client.telephone|tel }}</a> pour fixer l'heure, puis validez.</span>
                    <form method="post" action="{{ path('ramassage_confirmer', {id: ramassage.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('confirmer-ramassage-' ~ ramassage.id) }}">
                        <button class="btn btn-primary btn-sm"><i class="fas fa-check me-1"></i> Valider le rendez-vous</button>
                    </form>
                </div>
                {% elseif ramassage.id and ramassage.statut.value == 'en_attente' %}
                <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span><i class="fas fa-phone-alt me-1"></i> Rendez-vous pas encore confirmé : appelez {{ ramassage.client.nomComplet }} au <a href="tel:{{ ramassage.client.telephone }}">{{ ramassage.client.telephone|tel }}</a>.</span>
                    <form method="post" action="{{ path('ramassage_confirmer', {id: ramassage.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('confirmer-ramassage-' ~ ramassage.id) }}">
                        <button class="btn btn-info btn-sm"><i class="fas fa-check me-1"></i> Le client a confirmé</button>
                    </form>
                </div>
                {% elseif ramassage.statut.value == 'confirme' %}
                <div class="alert alert-info"><i class="fas fa-check-circle me-1"></i> Rendez-vous confirmé par le client.</div>
                {% endif %}
                {{ form_start(form) }}
                {{ form_row(form.client) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.datePrevue) }}</div>
                    <div class="col-md-6">{{ form_row(form.agent) }}</div>
                </div>
                {{ form_row(form.adresse) }}
                {{ form_row(form.commentaire) }}
                {{ form_row(form.statut) }}
                <div class="d-flex justify-content-between gap-2 flex-wrap">
                    <div>
                        {% if ramassage.id and ramassage.client %}
                            <a href="{{ path('colis_new', {client: ramassage.client.id}) }}" class="btn btn-primary light"><i class="fas fa-box me-1"></i> Saisir le colis</a>
                            {% set nav = itineraire(ramassage.client, ramassage.adresse) %}
                            {% if nav %}<a href="{{ nav }}" target="_blank" rel="noopener" class="btn btn-outline-primary"><i class="fas fa-route me-1"></i> Itinéraire</a>{% endif %}
                        {% endif %}
                    </div>
                    <div class="d-flex gap-2">
                        <a href="{{ path('ramassage_index') }}" class="btn btn-light">Annuler</a>
                        <button class="btn btn-primary"><i class="fas fa-check me-1"></i> Enregistrer</button>
                    </div>
                </div>
                {{ form_end(form) }}
                {% if ramassage.id %}
                <form method="post" action="{{ path('ramassage_delete', {id: ramassage.id}) }}" class="mt-3" data-confirm="Le rendez-vous sera retiré du planning." data-confirm-titre="Supprimer ce ramassage ?" data-confirm-type="danger" data-confirm-bouton="Oui, supprimer">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-ramassage-' ~ ramassage.id) }}">
                    <button class="btn btn-link text-danger px-0">Supprimer</button>
                </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
