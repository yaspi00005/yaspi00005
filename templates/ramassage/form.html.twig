{% extends 'base.html.twig' %}

{% block title %}{{ ramassage.id ? 'Ramassage chez ' ~ ramassage.client.nomComplet : 'Planifier un ramassage' }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-xl-7">
        <div class="card">
            <div class="card-header"><h4 class="card-title">{{ block('title') }}</h4></div>
            <div class="card-body">
                {{ form_start(form) }}
                {{ form_row(form.client) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.datePrevue) }}</div>
                    <div class="col-md-6">{{ form_row(form.agent) }}</div>
                </div>
                {{ form_row(form.adresse) }}
                {{ form_row(form.commentaire) }}
                {{ form_row(form.statut) }}
                <div class="d-flex justify-content-between gap-2 flex-wrap">
                    <div>
                        {% if ramassage.id and ramassage.client %}
                            <a href="{{ path('colis_new', {client: ramassage.client.id}) }}" class="btn btn-primary light"><i class="fas fa-box me-1"></i> Saisir le colis</a>
                        {% endif %}
                    </div>
                    <div class="d-flex gap-2">
                        <a href="{{ path('ramassage_index') }}" class="btn btn-light">Annuler</a>
                        <button class="btn btn-primary"><i class="fas fa-check me-1"></i> Enregistrer</button>
                    </div>
                </div>
                {{ form_end(form) }}
                {% if ramassage.id %}
                <form method="post" action="{{ path('ramassage_delete', {id: ramassage.id}) }}" class="mt-3" data-confirm="Supprimer ce ramassage ?">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-ramassage-' ~ ramassage.id) }}">
                    <button class="btn btn-link text-danger px-0">Supprimer</button>
                </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
