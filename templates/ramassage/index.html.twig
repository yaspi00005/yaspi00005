{% extends 'base.html.twig' %}

{% block title %}Planning des ramassages{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('theme/vendor/fullcalendar/css/main.min.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-xl-9">
        <div class="card">
            <div class="card-header flex-wrap gap-2">
                <h4 class="card-title">Calendrier</h4>
                <div class="d-flex flex-wrap gap-2">
                    {% if camions %}
                    <select id="filtre-camion" class="form-select form-control form-control-sm w-auto" aria-label="Afficher un camion">
                        <option value="">Tous les camions</option>
                        {% for c in camions %}<option value="{{ hid(c.id) }}">🚚 {{ c.nom }}</option>{% endfor %}
                    </select>
                    {% endif %}
                    <a href="{{ path('appel_index') }}" class="btn btn-outline-primary btn-rounded btn-sm"><i class="fas fa-phone-alt me-1"></i> Registre des appels</a>
                    <a href="{{ path('ramassage_new') }}" class="btn btn-primary btn-rounded btn-sm"><i class="fas fa-plus me-1"></i> Planifier un ramassage</a>
                </div>
            </div>
            <div class="card-body">
                <div id="calendrier" data-events="{{ path('ramassage_events') }}" data-token="{{ csrf_token('ramassage') }}" data-nouveau="{{ path('ramassage_new') }}"></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3">
        {% if demandes %}
        <div class="card border border-primary">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-globe text-primary me-2"></i>Demandes en ligne à traiter <span class="badge badge-primary ms-1">{{ demandes|length }}</span></h4></div>
            <div class="card-body">
                {% for r in demandes %}
                    <a href="{{ path('ramassage_edit', {id: r.id}) }}" class="d-block border-bottom py-2 text-decoration-none">
                        <span class="d-flex justify-content-between"><strong class="text-black">{{ r.client.nomComplet }}</strong><span class="text-primary">{{ r.datePrevue|date('d/m') }}</span></span>
                        <small class="text-muted d-block">{{ r.adresse ?: r.client.adresse }}</small>
                        <small class="text-muted"><i class="fas fa-phone-alt me-1"></i>{{ r.client.telephone|tel }}</small>
                    </a>
                {% endfor %}
                <p class="fs-12 text-muted mt-2 mb-0">Appelez le client pour fixer l'heure, puis « Valider le rendez-vous ».</p>
            </div>
        </div>
        {% endif %}
        {% if aPlanifier %}
        <div class="card border border-warning">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-calendar-plus text-warning me-2"></i>À planifier <span class="badge badge-warning ms-1">{{ aPlanifier|length }}</span></h4></div>
            <div class="card-body">
                {% for a in aPlanifier|slice(0, 15) %}
                    <a href="{{ path('appel_edit', {id: a.id}) }}" class="d-block border-bottom py-2 text-decoration-none">
                        <span class="d-flex justify-content-between"><strong class="text-black">{{ a.nomComplet }}</strong>{% if a.dateConteneurPrevue %}<span class="text-muted fs-12" title="Conteneur">📦 {{ a.dateConteneurPrevue|date('d/m') }}</span>{% endif %}</span>
                        <small class="text-muted d-block">{{ a.codePostal }} {{ a.ville }}{% if a.camion %} · 🚚 {{ a.camion.nom }}{% endif %}</small>
                    </a>
                {% endfor %}
                <p class="fs-12 text-muted mt-2 mb-0">Appels confirmés du registre sans date : ouvrez-les pour fixer le jour du ramassage.</p>
            </div>
        </div>
        {% endif %}
        <div class="card">
            <div class="card-header"><h4 class="card-title">À venir</h4></div>
            <div class="card-body">
                {% for r in aVenir %}
                    <div class="d-flex align-items-center gap-2 border-bottom py-2">
                        <a href="{{ path('ramassage_edit', {id: r.id}) }}" class="flex-grow-1 text-decoration-none">
                            <span class="d-flex justify-content-between"><strong class="text-black">{{ r.client.nomComplet }}{% if r.statut.value == 'confirme' %} <i class="fas fa-check-circle text-info" title="Confirmé par le client"></i>{% endif %}</strong><span class="text-primary">{{ r.datePrevue|date('d/m H:i') }}</span></span>
                            <small class="text-muted">{{ r.adresse ?: r.client.adresse }} {{ r.client.ville }}</small>
                        </a>
                        {% set nav = itineraire(r.client, r.adresse) %}
                        {% if nav %}<a href="{{ nav }}" target="_blank" rel="noopener" class="btn btn-primary light btn-xs sharp" title="Itinéraire vers le client" aria-label="Itinéraire vers {{ r.client.nomComplet }}"><i class="fas fa-route"></i></a>{% endif %}
                    </div>
                {% else %}
                    <p class="text-muted mb-0">Aucun ramassage prévu.</p>
                {% endfor %}
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-file-pdf text-primary me-2"></i>Export PDF</h4></div>
            <div class="card-body">
                <form method="get" action="{{ path('ramassage_export') }}" target="_blank" data-multi-submit>
                    {% if camions %}
                    <label class="form-label" for="export-camion">Camion</label>
                    <select name="camion" id="export-camion" class="form-select form-control mb-2">
                        <option value="">Tous les camions</option>
                        {% for c in camions %}<option value="{{ hid(c.id) }}">{{ c.nom }}{{ c.chauffeur ? ' — ' ~ c.chauffeur.prenom }}</option>{% endfor %}
                    </select>
                    {% endif %}
                    <label class="form-label" for="export-statut">Statut</label>
                    <select name="statut" id="export-statut" class="form-select form-control mb-2">
                        <option value="">Tous les statuts</option>
                        {% for s in statuts %}<option value="{{ s.value }}" {{ s.value == 'en_attente' ? 'selected' }}>{{ s.label }}</option>{% endfor %}
                    </select>
                    <div class="row g-2 mb-3">
                        <div class="col-6"><label class="form-label" for="export-du">Du</label><input type="date" name="du" id="export-du" class="form-control" value="{{ 'now'|date('Y-m-d') }}"></div>
                        <div class="col-6"><label class="form-label" for="export-au">Au</label><input type="date" name="au" id="export-au" class="form-control"></div>
                    </div>
                    <button class="btn btn-primary w-100"><i class="fas fa-download me-1"></i> Exporter en PDF</button>
                </form>
                <p class="fs-12 text-muted mt-2 mb-0">Laissez les dates vides pour tout exporter. Avec un camion : feuille de route du chauffeur.</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                {% for s in statuts %}<span class="badge badge-{{ s.badge }} me-1 mb-1">{{ s.label }}</span>{% endfor %}
                <p class="fs-12 text-muted mt-2 mb-0">Cliquez sur un jour pour planifier, glissez un rendez-vous pour le déplacer. Après avoir appelé le client, passez le ramassage en « Confirmé par le client ».</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block vendor_javascripts %}
    <script src="{{ asset('theme/vendor/fullcalendar/js/main.min.js') }}"></script>
    <script src="{{ asset('theme/vendor/fullcalendar/lib/fr.js') }}"></script>
{% endblock %}

{% block javascripts %}
<script nonce="{{ csp_nonce() }}">
document.addEventListener('DOMContentLoaded', function () {
    const el = document.getElementById('calendrier');
    const calendrier = new FullCalendar.Calendar(el, {
        locale: 'fr',
        timeZone: 'UTC', // heures « flottantes » : pas de conversion selon le fuseau du navigateur
        initialView: window.innerWidth < 768 ? 'listWeek' : 'dayGridMonth',
        headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,listWeek' },
        events: function (info, succes, echec) {
            const params = new URLSearchParams({ start: info.startStr, end: info.endStr });
            const camion = document.getElementById('filtre-camion');
            if (camion && camion.value) { params.set('camion', camion.value); }
            fetch(el.dataset.events + '?' + params, { credentials: 'same-origin' }).then(r => r.json()).then(succes).catch(echec);
        },
        editable: true,
        eventDurationEditable: false,
        dateClick: info => { window.location = el.dataset.nouveau + '?date=' + encodeURIComponent(info.dateStr); },
        eventDrop: function (info) {
            fetch(info.event.extendedProps.deplacer, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': el.dataset.token },
                body: JSON.stringify({ start: info.event.startStr })
            }).then(r => { if (!r.ok) { info.revert(); toastr.error('Déplacement impossible'); } else { toastr.success('Ramassage déplacé'); } });
        }
    });
    calendrier.render();
    const filtre = document.getElementById('filtre-camion');
    if (filtre) { filtre.addEventListener('change', () => calendrier.refetchEvents()); }
});
</script>
{% endblock %}
