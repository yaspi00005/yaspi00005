{% extends 'base.html.twig' %}

{% block title %}Expédition {{ expedition.numero }}{% endblock %}

{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="stat-icon bgl-primary text-primary"><i class="fas {{ expedition.modeTransport.icone }}"></i></span>
        <div>
            <h3 class="mb-0">{{ expedition.modeTransport.label }} → {{ expedition.destination.label }}</h3>
            <span class="text-muted">{{ expedition.numero }} · départ {{ expedition.dateDepart|date('d/m/Y') }}{% if expedition.reference %} · réf. {{ expedition.reference }}{% endif %}</span>
        </div>
        {% include 'partials/_badge.html.twig' with {statut: expedition.statut} %}
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="?{{ {q: filtres.q ?: null, statut: filtres.statut ?: null, paiement: filtres.paiement ?: null, tri: filtres.tri, sens: filtres.sens, export: 'csv'}|filter(v => v is not null)|url_encode }}" class="btn btn-outline-primary btn-rounded btn-sm" title="Manifeste Excel (colis filtrés et triés comme la liste)"><i class="fas fa-file-excel me-1"></i> Manifeste</a>
        {% if is_granted('ROLE_ADMIN') %}<button type="button" class="btn btn-outline-primary btn-rounded btn-sm" data-bs-toggle="modal" data-bs-target="#modal-etiquettes"><i class="fas fa-tags me-1"></i> Étiquettes</button>{% endif %}
        {% if is_granted('ROLE_ADMIN') %}
            {% if expedition.statut.value == 'en_preparation' %}
            <form method="post" action="{{ path('expedition_publier', {id: expedition.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('publier-expedition-' ~ expedition.id) }}">
                {% if expedition.publieeSurSite %}
                    <button class="btn btn-success btn-rounded btn-sm" title="Annonce visible sur sotrama.net — cliquer pour la retirer"><i class="fas fa-bullhorn me-1"></i> Publiée sur le site · Retirer</button>
                {% else %}
                    <button class="btn btn-outline-success btn-rounded btn-sm" title="Annoncer ce départ sur sotrama.net"><i class="fas fa-bullhorn me-1"></i> Publier sur le site</button>
                {% endif %}
            </form>
            {% endif %}
            <a href="{{ path('expedition_edit', {id: expedition.id}) }}" class="btn btn-primary btn-rounded btn-sm"><i class="fas fa-pen me-1"></i> Modifier</a>
            {% if expedition.colis is empty %}
            <form method="post" action="{{ path('expedition_delete', {id: expedition.id}) }}" data-confirm="L'expédition {{ expedition.numero }} et ses dépenses seront supprimées." data-confirm-titre="Supprimer cette expédition ?" data-confirm-type="danger" data-confirm-bouton="Oui, supprimer" data-confirm-alerte="Cette suppression est irréversible.">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-expedition-' ~ expedition.id) }}">
                <button class="btn btn-danger light btn-rounded btn-sm"><i class="fas fa-trash"></i></button>
            </form>
            {% endif %}
        {% endif %}
    </div>
</div>

<div class="row">
    {% for s in [
        {v: expedition.colis|length, l: 'Envois (n° de suivi)', i: 'fa-receipt', c: 'primary'},
        {v: clients, l: 'Clients', i: 'fa-users', c: 'info'},
        {v: expedition.nombreArticles, l: 'Nombre de colis', i: 'fa-boxes', c: 'warning'},
        {v: expedition.montantEncaisse|money, l: 'Encaissé sur ' ~ expedition.montantTotal|money, i: 'fa-euro-sign', c: 'success'},
    ] %}
    <div class="col-xl-3 col-sm-6">
        <div class="card stat-card"><div class="card-body d-flex align-items-center gap-3">
            <span class="stat-icon bgl-{{ s.c }} text-{{ s.c }}"><i class="fas {{ s.i }}"></i></span>
            <div><div class="stat-value">{{ s.v }}</div><span class="text-muted fs-14">{{ s.l }}</span></div>
        </div></div>
    </div>
    {% endfor %}

    {% if is_granted('ROLE_ADMIN') %}
    {# Rentabilité : chiffre d'affaires (tarifs − remises) moins les charges de l'expédition. #}
    {% set marge = expedition.marge %}
    <div class="col-12" id="rentabilite">
        <div class="card">
            <div class="card-header flex-wrap gap-2">
                <h4 class="card-title"><i class="fas fa-chart-line text-primary me-2"></i>Rentabilité</h4>
                <a href="{{ path('expedition_rentabilite', {annee: expedition.dateDepart|date('Y')}) }}" class="btn btn-primary light btn-sm btn-rounded">Toutes les expéditions</a>
            </div>
            <div class="card-body">
                <div class="row g-3 text-center mb-4">
                    <div class="col-6 col-md-3"><div class="stat-value">{{ expedition.chiffreAffaires|money }}</div><span class="text-muted fs-14">Chiffre d'affaires</span><div class="fs-12 text-muted">dont {{ expedition.totalEncaisse|money }} encaissé</div></div>
                    <div class="col-6 col-md-3"><div class="stat-value text-danger">{{ expedition.totalDepenses|money }}</div><span class="text-muted fs-14">Charges</span></div>
                    <div class="col-6 col-md-3"><div class="stat-value {{ marge >= 0 ? 'text-success' : 'text-danger' }}">{{ marge >= 0 ? '+' }}{{ marge|money }}</div><span class="text-muted fs-14">Marge</span></div>
                    <div class="col-6 col-md-3">
                        {% if marge > 0 %}<span class="badge badge-success fs-14"><i class="fas fa-arrow-up me-1"></i>Gain{% if expedition.tauxMarge is not null %} · {{ expedition.tauxMarge|number_format(1, ',', ' ') }} %{% endif %}</span>
                        {% elseif marge < 0 %}<span class="badge badge-danger fs-14"><i class="fas fa-arrow-down me-1"></i>Perte{% if expedition.tauxMarge is not null %} · {{ expedition.tauxMarge|number_format(1, ',', ' ') }} %{% endif %}</span>
                        {% else %}<span class="badge badge-light fs-14">Équilibre</span>{% endif %}
                        <div class="fs-12 text-muted mt-2">{{ expedition.depenses is empty ? 'Aucune charge saisie' : expedition.depenses|length ~ ' charge(s)' }}</div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-7">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead><tr><th>Date</th><th>Dépense</th><th class="num">Montant</th><th></th></tr></thead>
                                <tbody>
                                {% for d in expedition.depenses %}
                                    <tr>
                                        <td>{{ d.date|date('d/m/Y') }}</td>
                                        <td><i class="fas {{ d.categorie.icone }} text-muted me-1"></i> {{ d.categorie.label }}{% if d.libelle %}<br><small class="text-muted">{{ d.libelle }}</small>{% endif %}</td>
                                        <td class="num font-w600">{{ d.montant|money }}</td>
                                        <td class="text-end">
                                            <form method="post" action="{{ path('expedition_depense_delete', {id: expedition.id, depense: d.id}) }}" data-confirm="La marge de l'expédition sera recalculée." data-confirm-titre="Supprimer cette dépense ?" data-confirm-type="danger" data-confirm-bouton="Oui, supprimer">
                                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-depense-' ~ d.id) }}">
                                                <button class="btn btn-danger light btn-xs" aria-label="Supprimer la dépense"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="4"><div class="empty-state"><i class="fas fa-receipt"></i>Ajoutez les charges (fret, douane, transport…) pour obtenir la marge.</div></td></tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <h5 class="mb-3">Ajouter une dépense</h5>
                        {{ form_start(formDepense) }}
                            {{ form_row(formDepense.categorie) }}
                            {{ form_row(formDepense.libelle) }}
                            <div class="row">
                                <div class="col-6">{{ form_row(formDepense.montant) }}</div>
                                <div class="col-6">{{ form_row(formDepense.date) }}</div>
                            </div>
                            <button class="btn btn-primary w-100"><i class="fas fa-plus me-1"></i> Ajouter</button>
                        {{ form_end(formDepense) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="col-xl-9">
        <div class="card">
            {% set filtre = filtres.q or filtres.statut or filtres.paiement %}
            <div class="card-header flex-wrap gap-2" id="colis">
                <h4 class="card-title">Colis de l'expédition <small class="text-muted fs-14">({{ colisListe|length }}{{ filtre ? ' sur ' ~ expedition.colis|filter(c => is_granted('COLIS_VOIR', c))|length }})</small></h4>
                <div class="d-flex flex-wrap gap-2">
                    {% if filtre %}<a href="{{ path('expedition_show', {id: expedition.id}) }}#colis" class="btn btn-light btn-sm btn-rounded"><i class="fas fa-times me-1"></i> Effacer les filtres</a>{% endif %}
                    {% set parametres = {q: filtres.q ?: null, statut: filtres.statut ?: null, paiement: filtres.paiement ?: null, tri: filtres.tri, sens: filtres.sens}|filter(v => v is not null) %}
                    <div class="dropdown">
                        <button class="btn btn-primary btn-sm btn-rounded dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-download me-1"></i> Exporter{{ filtre ? ' la sélection' }}</button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a class="dropdown-item" href="?{{ parametres|merge({export: 'csv'})|url_encode }}"><i class="fas fa-file-excel text-success me-2"></i>Excel (manifeste complet)</a>
                            <a class="dropdown-item" href="?{{ parametres|merge({export: 'pdf'})|url_encode }}" target="_blank"><i class="fas fa-file-pdf text-danger me-2"></i>PDF (liste à imprimer)</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body pt-0">
                {# Filtres et tri : aussi appliqués au manifeste Excel. #}
                <form method="get" action="#colis" class="row g-2 mb-3">
                    <input type="hidden" name="tri" value="{{ filtres.tri }}"><input type="hidden" name="sens" value="{{ filtres.sens }}">
                    <div class="col-md-5"><input type="search" name="q" value="{{ filtres.q }}" class="form-control" placeholder="N° de suivi, client, destinataire, téléphone…" aria-label="Rechercher un colis"></div>
                    <div class="col-6 col-md-3">
                        <select name="statut" class="form-control form-select" aria-label="Statut" data-envoi-auto>
                            <option value="">Tous les statuts</option>
                            {% for st in statutsColis %}<option value="{{ st.value }}" {{ filtres.statut == st.value ? 'selected' }}>{{ st.label }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <select name="paiement" class="form-control form-select" aria-label="Paiement" data-envoi-auto>
                            <option value="">Tous les paiements</option>
                            <option value="reste" {{ filtres.paiement == 'reste' ? 'selected' }}>Reste à payer</option>
                            <option value="solde" {{ filtres.paiement == 'solde' ? 'selected' }}>Soldés</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-grid"><button class="btn btn-primary" aria-label="Filtrer"><i class="fas fa-search"></i></button></div>
                </form>
                {% macro tri(libelle, cle, filtres, expedition, classe = '') %}
                    {% set actif = filtres.tri == cle %}
                    {% set sens = actif and filtres.sens == 'asc' ? 'desc' : 'asc' %}
                    <th class="{{ classe }}"><a href="{{ path('expedition_show', {id: expedition.id, q: filtres.q ?: null, statut: filtres.statut ?: null, paiement: filtres.paiement ?: null, tri: cle, sens: sens}) }}#colis" class="lien-tri{{ actif ? ' actif' }}" title="Trier par {{ libelle|lower }}">{{ libelle }} <i class="fas fa-{{ actif ? (filtres.sens == 'asc' ? 'sort-up' : 'sort-down') : 'sort' }}"></i></a></th>
                {% endmacro %}
                {% import _self as t %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr>
                            {{ t.tri('N° suivi', 'numero', filtres, expedition) }}{{ t.tri('Client', 'client', filtres, expedition) }}{{ t.tri('Destinataire', 'destinataire', filtres, expedition) }}
                            {{ t.tri('Nb colis', 'nombre', filtres, expedition, 'num') }}{{ t.tri('Montant', 'montant', filtres, expedition, 'num') }}{{ t.tri('Reste', 'reste', filtres, expedition, 'num') }}
                            {{ t.tri('Statut', 'statut', filtres, expedition) }}<th></th>
                        </tr></thead>
                        <tbody>
                        {% for c in colisListe %}
                            <tr>
                                <td><a href="{{ path('colis_show', {id: c.id, retour: app.request.requestUri}) }}" class="text-primary font-w600">{{ c.numeroSuivi }}</a></td>
                                <td>{{ c.client.nomComplet }}</td>
                                <td>{{ c.destinataireNom }}<br><small class="text-muted">{{ c.destinataireTelephone|tel }}</small></td>
                                <td class="num">{{ c.nombreArticles }}</td>
                                <td class="num">{{ c.montantNet|money }}</td>
                                <td class="num {{ c.montantRestant ? 'text-danger font-w600' }}">{{ c.montantRestant|money }}</td>
                                <td>{% include 'partials/_badge.html.twig' with {statut: c.statut} %}</td>
                                <td class="text-end">
                                    {% if is_granted('ROLE_ADMIN') and expedition.statut.accepteNouveauxColis %}
                                    <form method="post" action="{{ path('expedition_retirer', {id: expedition.id, colis: c.id}) }}" data-confirm="Le colis restera enregistré, sans expédition." data-confirm-titre="Retirer ce colis de l'expédition ?" data-confirm-type="warning" data-confirm-bouton="Oui, retirer">
                                        <input type="hidden" name="_token" value="{{ csrf_token('retirer-colis-' ~ c.id) }}">
                                        <button class="btn btn-danger light btn-xs sharp" title="Retirer de l'expédition" aria-label="Retirer de l'expédition"><i class="fas fa-times"></i></button>
                                    </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="8"><div class="empty-state"><i class="fas fa-box-open"></i>{{ filtre ? 'Aucun colis pour ces critères.' : 'Aucun colis dans cette expédition.' }}</div></td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {% if colisSansExpedition %}
        <div class="card">
            <div class="card-header"><h4 class="card-title">Colis en attente d'affectation ({{ colisSansExpedition|length }})</h4></div>
            <div class="card-body pt-0">
                <form method="post" action="{{ path('expedition_affecter', {id: expedition.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('affecter-expedition-' ~ expedition.id) }}">
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th><input type="checkbox" class="form-check-input" data-tout-cocher=".js-affecter" aria-label="Tout sélectionner"></th><th>N° suivi</th><th>Client</th><th>Reçu le</th><th class="num">Nb colis</th></tr></thead>
                            <tbody>
                            {% for c in colisSansExpedition %}
                                <tr>
                                    <td><input type="checkbox" name="colis[]" value="{{ hid(c.id) }}" class="form-check-input js-affecter" aria-label="Sélectionner {{ c.numeroSuivi }}"></td>
                                    <td>{{ c.numeroSuivi }}</td><td>{{ c.client.nomComplet }}</td><td>{{ c.dateReception|date('d/m/Y') }}</td><td class="num">{{ c.nombreArticles }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i> Ajouter à l'expédition</button>
                </form>
            </div>
        </div>
        {% endif %}
    </div>

    <div class="col-xl-3">
        {% if is_granted('ROLE_ADMIN') %}
        <div class="card">
            <div class="card-header"><h4 class="card-title">Statut</h4></div>
            <div class="card-body">
                <form method="post" action="{{ path('expedition_statut', {id: expedition.id}) }}" data-confirm="Le nouveau statut sera appliqué à tous les colis de l'expédition (sauf ceux déjà remis)." data-confirm-titre="Changer le statut ?" data-confirm-type="primary" data-confirm-bouton="Oui, mettre à jour">
                    <input type="hidden" name="_token" value="{{ csrf_token('statut-expedition-' ~ expedition.id) }}">
                    <select name="statut" class="form-select form-control mb-2" aria-label="Nouveau statut">
                        {% for s in statuts %}<option value="{{ s.value }}" {{ s == expedition.statut ? 'selected' }}>{{ s.label }}</option>{% endfor %}
                    </select>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="notifier" value="1" id="notifier" checked>
                        <label class="form-check-label" for="notifier">Prévenir les destinataires (SMS / e-mail)</label>
                    </div>
                    <button class="btn btn-primary w-100">Mettre à jour</button>
                </form>
                <p class="fs-12 text-muted mt-2 mb-0">Le statut est appliqué à tous les colis de l'expédition (sauf ceux déjà remis).</p>
            </div>
        </div>
        {% endif %}

        <div class="card">
            <div class="card-header"><h4 class="card-title">Colis par statut</h4></div>
            <div class="card-body">
                {% for statut, n in parStatut %}
                    <div class="d-flex justify-content-between py-1"><span>{{ enum('App\\Enum\\StatutColis').from(statut).label }}</span><strong>{{ n }}</strong></div>
                {% else %}<span class="text-muted">—</span>{% endfor %}
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h4 class="card-title">Encaissements par caissier</h4></div>
            <div class="card-body">
                {% for c in parCaissier %}
                    <div class="d-flex justify-content-between py-1"><span>{{ c.caissier }}</span><strong>{{ c.total|money }}</strong></div>
                {% else %}<span class="text-muted">Aucun encaissement.</span>{% endfor %}
            </div>
        </div>
    </div>
</div>
{% if is_granted('ROLE_ADMIN') %}{% include 'partials/_modal_etiquettes.html.twig' with {action: path('expedition_etiquettes', {id: expedition.id}), nombre: null, titre: 'Étiquettes de tous les colis de ' ~ expedition.numero} %}{% endif %}
{% endblock %}
