{% extends 'base.html.twig' %}

{% block title %}{{ expedition.id ? 'Modifier l\'expédition ' ~ expedition.numero : 'Nouvelle expédition' }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-xl-7">
        <div class="card">
            <div class="card-header"><h4 class="card-title">{{ block('title') }}</h4></div>
            <div class="card-body">
                {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.modeTransport) }}</div>
                    <div class="col-md-6">{{ form_row(form.destination) }}</div>
                    <div class="col-md-6">{{ form_row(form.dateDepart) }}</div>
                    <div class="col-md-6">{{ form_row(form.dateArriveePrevue) }}</div>
                    <div class="col-12">{{ form_row(form.reference) }}</div>
                    <div class="col-12">{{ form_row(form.notes) }}</div>
                    <div class="col-12"><hr><h5 class="mb-3"><i class="fas fa-bullhorn text-primary me-2"></i>Annonce sur le site sotrama.net</h5></div>
                    <div class="col-12">{{ form_row(form.publieeSurSite) }}</div>
                    <div class="col-md-6">{{ form_row(form.dateLimiteDepot) }}</div>
                    <div class="col-12">{{ form_row(form.annonce) }}</div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ expedition.id ? path('expedition_show', {id: expedition.id}) : path('expedition_index') }}" class="btn btn-light">Annuler</a>
                    <button class="btn btn-primary"><i class="fas fa-check me-1"></i> Enregistrer</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
