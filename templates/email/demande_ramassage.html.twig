<!DOCTYPE html>
<html lang="fr">
<body style="margin:0;background:#f4f5f7;font-family:Arial,sans-serif;color:#222">
<table width="100%" cellpadding="0" cellspacing="0" style="padding:24px 0"><tr><td align="center">
<table width="560" cellpadding="0" cellspacing="0" style="background:#fff;border-radius:12px;overflow:hidden">
    <tr><td style="background:#00A15D;color:#fff;padding:20px 28px;font-size:20px;font-weight:bold">{{ app_nom }} — Nouvelle demande en ligne</td></tr>
    <tr><td style="padding:28px">
        <p>Bonjour {{ agent.prenom }},</p>
        <p style="font-size:17px;margin:18px 0"><strong>{{ ramassage.client.nomComplet }}</strong> demande un ramassage sur sotrama.net.</p>
        <table cellpadding="6" style="font-size:14px">
            <tr><td style="color:#777">Jour souhaité</td><td>{{ ramassage.datePrevue|date('d/m/Y') }} (heure à fixer en appelant le client)</td></tr>
            <tr><td style="color:#777">Adresse</td><td>{{ ramassage.adresse }}</td></tr>
            <tr><td style="color:#777">Téléphone</td><td><a href="tel:{{ ramassage.client.telephone }}">{{ ramassage.client.telephone }}</a></td></tr>
            {% if ramassage.commentaire %}<tr><td style="color:#777;vertical-align:top">Détails</td><td>{{ ramassage.commentaire|nl2br }}</td></tr>{% endif %}
        </table>
        <p style="margin:26px 0"><a href="{{ lien }}" style="background:#00A15D;color:#fff;text-decoration:none;padding:12px 22px;border-radius:24px">Valider le rendez-vous</a></p>
        <p style="color:#777;font-size:12px">La demande figure aussi dans le registre des appels et dans le planning (à valider).</p>
    </td></tr>
</table>
</td></tr></table>
</body>
</html>
