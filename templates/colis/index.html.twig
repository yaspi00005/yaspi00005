{% extends 'base.html.twig' %}

{% block title %}Colis{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header flex-wrap gap-2">
        <h4 class="card-title">{{ colis.total }} colis</h4>
        <div class="d-flex gap-2">
            <a href="?{{ app.request.query.all|merge({export: 'csv', page: null})|url_encode }}" class="btn btn-outline-primary btn-sm btn-rounded"><i class="fas fa-file-excel me-1"></i> Export Excel</a>
            {% if is_granted('ROLE_RAMASSAGE') %}
                <a href="{{ path('colis_new') }}" class="btn btn-primary btn-sm btn-rounded"><i class="fas fa-plus me-1"></i> Nouveau colis</a>
            {% endif %}
        </div>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 filtres mb-3">
            <div class="col-md-3"><input type="search" name="q" value="{{ filtres.q }}" class="form-control" placeholder="N°, client, destinataire, tél."></div>
            <div class="col-6 col-md-2">
                <select name="statut" class="form-select form-control">
                    <option value="">Tous statuts</option>
                    {% for s in statuts %}<option value="{{ s.value }}" {{ filtres.statut == s.value ? 'selected' }}>{{ s.label }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="paiement" class="form-select form-control">
                    <option value="">Tous paiements</option>
                    {% for s in statutsPaiement %}<option value="{{ s.value }}" {{ filtres.paiement == s.value ? 'selected' }}>{{ s.label }}</option>{% endfor %}
                </select>
            </div>
            {% if is_granted('ROLE_RAMASSAGE') %}
            <div class="col-md-2">
                <select name="expedition" class="form-select form-control">
                    <option value="">Toutes expéditions</option>
                    {% for e in expeditions %}<option value="{{ hid(e.id) }}" {{ filtres.expedition == e.id ? 'selected' }}>{{ e.numero }} · {{ e.destination.label }}</option>{% endfor %}
                </select>
            </div>
            {% endif %}
            <div class="col-6 col-md-1"><input type="date" name="du" value="{{ filtres.du }}" class="form-control" title="Reçu depuis le" aria-label="Reçu depuis le"></div>
            <div class="col-6 col-md-1"><input type="date" name="au" value="{{ filtres.au }}" class="form-control" title="Reçu jusqu'au" aria-label="Reçu jusqu'au"></div>
            <div class="col-md-1 d-flex gap-1">
                <button class="btn btn-primary w-100" type="submit" aria-label="Filtrer"><i class="fas fa-filter"></i></button>
                <a href="{{ path('colis_index') }}" class="btn btn-light" title="Réinitialiser" aria-label="Réinitialiser"><i class="fas fa-times"></i></a>
            </div>
        </form>

        {% if recuperesMasques %}
            <p class="text-muted small mb-3">
                <i class="fas fa-eye-slash me-1"></i>
                {{ recuperesMasques }} colis déjà récupéré{{ recuperesMasques > 1 ? 's' }} ne {{ recuperesMasques > 1 ? 'sont' : 'est' }} pas affiché{{ recuperesMasques > 1 ? 's' }} : faites une recherche pour les retrouver, ou
                <a href="{{ path('colis_index', {tous: 1}) }}">affichez tous les colis</a>.
            </p>
        {% elseif app.request.query.get('tous') %}
            <p class="text-muted small mb-3"><i class="fas fa-eye me-1"></i> Tous les colis sont affichés, y compris ceux déjà récupérés. <a href="{{ path('colis_index') }}">Masquer les colis récupérés</a>.</p>
        {% endif %}

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>N° suivi</th>
                        <th>Client</th>
                        <th>Destinataire</th>
                        {% if is_granted('ROLE_RAMASSAGE') %}<th>Expédition</th>{% endif %}
                        <th class="num">Poids</th>
                        <th class="num">Montant</th>
                        <th class="num">Reste</th>
                        <th>Statut</th>
                        <th>Paiement</th>
                        {% if not agentSeul %}<th>Ajouté par</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                {% for c in colis %}
                    <tr>
                        <td><a href="{{ path('colis_show', {id: c.id, retour: app.request.requestUri}) }}" class="text-primary font-w600">{{ c.numeroSuivi }}</a><br><small class="text-muted">{{ c.dateReception|date('d/m/Y H:i') }}</small></td>
                        <td>{{ c.client.nomComplet }}<br><small class="text-muted">{{ c.client.telephone|tel }}</small></td>
                        <td>{{ c.destinataireNom }}<br><small class="text-muted">{{ c.destinataireTelephone|tel }}</small></td>
                        {% if is_granted('ROLE_RAMASSAGE') %}<td>{% if c.expedition %}{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('expedition_show', {id: c.expedition.id}) }}">{{ c.expedition.numero }}</a>{% else %}{{ c.expedition.numero }}{% endif %}<br><small class="text-muted">{{ c.expedition.destination.label }}</small>{% else %}<span class="text-muted">—</span>{% endif %}</td>{% endif %}
                        <td class="num">{{ c.poidsTotal|poids }}</td>
                        <td class="num">{{ c.montantNet|money_local }}</td>
                        <td class="num {{ c.montantRestant > 0 ? 'text-danger font-w600' }}">{{ c.montantRestant|money_local }}</td>
                        <td>{% include 'partials/_badge.html.twig' with {statut: c.statut} %}</td>
                        <td>{% include 'partials/_badge.html.twig' with {statut: c.statutPaiement} %}</td>
                        {% if not agentSeul %}<td>{{ c.agent ? c.agent.nomComplet : '—' }}</td>{% endif %}
                    </tr>
                {% else %}
                    <tr><td colspan="10"><div class="empty-state"><i class="fas fa-search"></i>Aucun colis ne correspond à ces critères.</div></td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% include 'partials/_pagination.html.twig' with {pagination: colis} %}
    </div>
</div>
{% endblock %}
