{% extends 'base.html.twig' %}

{% block title %}Colis {{ colis.numeroSuivi }}{% endblock %}

{% block body %}
{% set peutEncaisser = is_granted('COLIS_ENCAISSER', colis) %}
{% set peutLivrer = is_granted('COLIS_LIVRER', colis) %}

{# Venu d'une liste (paiements filtrés, expédition, guichet…) : lien pour y revenir, filtres compris. #}
{% set champRetour %}{% if retour %}<input type="hidden" name="retour" value="{{ retour.url }}">{% endif %}{% endset %}
{% if retour and app.request.query.get('paye') %}
<div class="alert alert-info solid-alert d-flex flex-wrap align-items-center justify-content-between gap-2">
    <span><i class="fas fa-check-circle me-2"></i>Paiement enregistré. Revenir à la page d'où vous venez ?</span>
    <a href="{{ retour.url }}" class="btn btn-light btn-sm"><i class="fas fa-arrow-left me-1"></i> {{ retour.libelle }}</a>
</div>
{% endif %}

{% if app.request.query.get('nouveau') %}
<div class="alert alert-success solid-alert d-flex flex-wrap align-items-center justify-content-between gap-2">
    <span><i class="fas fa-check-circle me-2"></i>Colis enregistré. Remettez le reçu au client : il contient le code de retrait <strong class="code-retrait">{{ colis.codeRetrait }}</strong>. Collez une étiquette sur chaque carton.</span>
    <span class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#modal-etiquettes"><i class="fas fa-tags me-1"></i> Imprimer les étiquettes</button>
        <a href="{{ path('colis_recu', {id: colis.id}) }}" target="_blank" class="btn btn-light btn-sm"><i class="fas fa-print me-1"></i> Imprimer le reçu</a>
        {% if whatsappExpediteur %}<a href="{{ whatsappExpediteur }}" target="_blank" rel="noopener" class="btn btn-light btn-sm"><i class="fab fa-whatsapp me-1"></i> Envoyer par WhatsApp</a>{% endif %}
    </span>
</div>
{% endif %}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        {% if retour %}<a href="{{ retour.url }}" class="d-inline-block small mb-1"><i class="fas fa-arrow-left me-1"></i>{{ retour.libelle }}</a>{% endif %}
        <h3 class="mb-1">{{ colis.numeroSuivi }}</h3>
        {% include 'partials/_badge.html.twig' with {statut: colis.statut} %}
        {% include 'partials/_badge.html.twig' with {statut: colis.statutPaiement} %}
        <span class="badge light badge-dark">{{ colis.typeExpedition.label }}</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="{{ path('colis_recu', {id: colis.id}) }}" target="_blank" class="btn btn-outline-primary btn-rounded btn-sm"><i class="fas fa-file-pdf me-1"></i> Reçu PDF</a>
        <button type="button" class="btn btn-outline-primary btn-rounded btn-sm" data-bs-toggle="modal" data-bs-target="#modal-etiquettes"><i class="fas fa-tags me-1"></i> Étiquettes</button>
        {% if is_granted('COLIS_MODIFIER', colis) %}
            <a href="{{ path('colis_edit', {id: colis.id}) }}" class="btn btn-primary btn-rounded btn-sm"><i class="fas fa-pen me-1"></i> Modifier</a>
            {% if colis.supprimable %}
            <form method="post" action="{{ path('colis_delete', {id: colis.id}) }}" data-confirm="Le colis {{ colis.numeroSuivi }} ne comptera plus nulle part (listes, totaux, statistiques). Vous pourrez le restaurer depuis la Corbeille pendant 7 jours ; ensuite il sera supprimé définitivement avec ses photos." data-confirm-titre="Supprimer ce colis ?" data-confirm-type="danger" data-confirm-bouton="Oui, mettre à la corbeille">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-colis-' ~ colis.id) }}">
                <button class="btn btn-danger light btn-rounded btn-sm"><i class="fas fa-trash me-1"></i> Supprimer</button>
            </form>
            {% endif %}
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header"><h4 class="card-title">Expéditeur</h4></div>
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <span class="avatar-initiales">{{ colis.client.initiales }}</span>
                            <div>
                                {% if is_granted('ROLE_RAMASSAGE') %}
                                    <a href="{{ path('client_show', {id: colis.client.id}) }}" class="fs-18 font-w600 text-black">{{ colis.client.nomComplet }}</a>
                                {% else %}
                                    <span class="fs-18 font-w600 text-black">{{ colis.client.nomComplet }}</span>
                                {% endif %}
                                <div class="text-muted"><i class="fas fa-phone-alt me-1"></i> <a href="tel:{{ colis.client.telephone }}">{{ colis.client.telephone|tel }}</a></div>
                                {% if colis.client.ville %}<div class="text-muted"><i class="fas fa-map-pin me-1"></i> {{ colis.client.ville }}, {{ colis.client.pays }}</div>{% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header"><h4 class="card-title">Destinataire</h4></div>
                    <div class="card-body">
                        <div class="fs-18 font-w600 text-black">{{ colis.destinataireNom }}</div>
                        <div class="text-muted"><i class="fas fa-phone-alt me-1"></i> <a href="tel:{{ colis.destinataireTelephone }}">{{ colis.destinataireTelephone|tel }}</a></div>
                        <div class="text-muted mt-1"><i class="fas fa-key me-1"></i> Code de retrait :
                            {% if is_granted('ROLE_RAMASSAGE') %}<span class="code-retrait text-black">{{ colis.codeRetrait }}</span>{% else %}<span class="code-retrait">••••••</span> <small>(présenté par le destinataire)</small>{% endif %}</div>
                        {% if colis.dateRecuperation %}
                            <div class="text-success mt-1"><i class="fas fa-check me-1"></i> Remis le {{ colis.dateRecuperation|date('d/m/Y H:i') }} à {{ colis.recupererPar }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Photos des articles en grand : celles reprises de l'ancienne application sont toutes sur les articles. #}
        {% set articlesAvecPhoto = colis.articles|filter(a => a.photo) %}
        {% if colis.photo or articlesAvecPhoto|length %}
        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-camera text-primary me-2"></i>{{ colis.photo and not articlesAvecPhoto|length ? 'Photo du colis' : 'Photos' }}</h4></div>
            <div class="card-body pt-0 d-flex flex-wrap gap-3">
                {% if colis.photo %}
                    <a href="{{ path('colis_photo', {id: colis.id}) }}" target="_blank"><img src="{{ path('colis_photo', {id: colis.id}) }}" alt="Photo du colis {{ colis.numeroSuivi }}" class="photo-colis"></a>
                {% endif %}
                {% for a in articlesAvecPhoto %}
                    <a href="{{ path('article_photo', {id: a.id}) }}" target="_blank" title="{{ a.typeMarchandise }}"><img src="{{ path('article_photo', {id: a.id}) }}" alt="Photo de l'article {{ a.typeMarchandise }}" class="photo-colis" loading="lazy"></a>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Articles : {{ colis.nombreArticles }} colis</h4>
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>Photo</th><th>Marchandise</th><th>Observations</th><th class="num">Prix</th></tr></thead>
                        <tbody>
                        {% for a in colis.articles %}
                            <tr>
                                <td>{% if a.photo %}<a href="{{ path('article_photo', {id: a.id}) }}" target="_blank"><img src="{{ path('article_photo', {id: a.id}) }}" alt="Photo de l'article" class="rounded" style="width:56px;height:56px;object-fit:cover"></a>{% else %}<span class="text-muted">—</span>{% endif %}</td>
                                <td class="font-w600">{{ a.typeMarchandise }}</td>
                                <td class="text-muted">{{ a.observations }}</td>
                                <td class="num">{{ a.prix|money }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if colis.observations %}<p class="mt-3 mb-0"><strong>Observations :</strong> {{ colis.observations }}</p>{% endif %}
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h4 class="card-title">Paiements</h4></div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>Date</th><th>Mode</th><th class="num">Montant</th><th class="num">Remise</th><th>Caissier</th><th></th></tr></thead>
                        <tbody>
                        {% for p in colis.paiements %}
                            <tr>
                                <td>{{ p.date|date('d/m/Y H:i') }}</td>
                                <td>{{ p.mode.label }}{% if p.reference %}<br><small class="text-muted">{{ p.reference }}</small>{% endif %}</td>
                                <td class="num">{{ p.montant|money_local }}</td>
                                <td class="num">{{ p.remise ? p.remise|money_local : '—' }}</td>
                                <td>{{ p.caissier ? p.caissier.nomComplet : '—' }}</td>
                                <td class="text-end">
                                    {% if is_granted('ROLE_ADMIN') %}
                                    <form method="post" action="{{ path('paiement_annuler', {id: p.id}) }}" data-confirm="Le montant sera retiré du total payé de ce colis. L'annulation est enregistrée dans le journal." data-confirm-titre="Annuler ce paiement ?" data-confirm-type="warning" data-confirm-bouton="Oui, annuler le paiement">
                                        {{ champRetour }}
                                        <input type="hidden" name="_token" value="{{ csrf_token('annuler-paiement-' ~ p.id) }}">
                                        <button class="btn btn-danger light btn-xs sharp" title="Annuler ce paiement" aria-label="Annuler ce paiement"><i class="fas fa-undo"></i></button>
                                    </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="text-muted text-center py-4">Aucun paiement enregistré.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        {% if is_granted('ROLE_RAMASSAGE') %}
        <div class="card carte-envoi-recu">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-paper-plane text-primary me-2"></i>Envoyer le reçu</h4></div>
            <div class="card-body pt-0">
                <div class="d-grid gap-2">
                    {% if whatsappExpediteur %}
                        <a href="{{ whatsappExpediteur }}" target="_blank" rel="noopener" class="btn btn-whatsapp"><i class="fab fa-whatsapp me-1"></i> Reçu à {{ colis.client.prenom }} (expéditeur)</a>
                    {% else %}
                        <span class="text-muted fs-13">Téléphone de l'expéditeur inutilisable pour WhatsApp.</span>
                    {% endif %}
                    {% if whatsappDestinataire %}
                        <a href="{{ whatsappDestinataire }}" target="_blank" rel="noopener" class="btn btn-outline-success"><i class="fab fa-whatsapp me-1"></i> Prévenir {{ colis.destinataireNom }} (destinataire)</a>
                    {% endif %}
                    <button type="button" class="btn btn-light d-none js-partager-recu" data-url="{{ path('colis_recu', {id: colis.id}) }}" data-nom="recu-{{ colis.numeroSuivi }}.pdf" data-titre="Reçu SOTRAMA {{ colis.numeroSuivi }}"><i class="fas fa-share-alt me-1"></i> Partager le fichier PDF…</button>
                    {% if colis.client.email %}
                        <form method="post" action="{{ path('colis_recu_email', {id: colis.id}) }}" class="d-grid">
                            {{ champRetour }}
                            <input type="hidden" name="_token" value="{{ csrf_token('recu-email-' ~ colis.id) }}">
                            <button class="btn btn-outline-primary"><i class="fas fa-envelope me-1"></i> Par e-mail à {{ colis.client.email }}</button>
                        </form>
                    {% else %}
                        <a href="{{ path('client_edit', {id: colis.client.id}) }}" class="fs-13 text-muted"><i class="fas fa-envelope me-1"></i> Ajouter un e-mail au client pour l'envoi par e-mail</a>
                    {% endif %}
                </div>
                <p class="fs-12 text-muted mt-2 mb-0">WhatsApp s'ouvre avec le message et le lien du reçu déjà écrits : il reste à appuyer sur « Envoyer ». Le destinataire reçoit le suivi, pas le reçu (qui porte le code de retrait).</p>
            </div>
        </div>
        {% endif %}
        <div class="card">
            <div class="card-header"><h4 class="card-title">Montants</h4></div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2"><span>Tarif</span><strong class="text-end">{{ colis.frais|money_local }}</strong></div>
                <div class="d-flex justify-content-between mb-2"><span>Remises</span><strong class="text-end">− {{ colis.remise|money_local }}</strong></div>
                <div class="d-flex justify-content-between mb-2"><span>Déjà payé</span><strong class="text-success text-end">{{ colis.montantPaye|money_local }}</strong></div>
                <hr>
                <div class="d-flex justify-content-between align-items-center"><span class="fs-18">Reste à payer</span><strong class="fs-24 {{ colis.montantRestant ? 'text-danger' : 'text-success' }} text-end">{{ colis.montantRestant|money_local }}</strong></div>
                {% if bonusGagne > 0 %}
                    <div class="alert alert-success mt-3 mb-0 py-2"><i class="fas fa-gift me-1"></i> Ce colis rapporte <strong>{{ bonusGagne|money }}</strong> de bonus fidélité au client.</div>
                {% endif %}
                {% if bonusDisponible > 0 %}
                    <div class="alert alert-info mt-2 mb-0 py-2">Bonus utilisable sur ce colis : <strong>{{ bonusDisponible|money }}</strong></div>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                <details class="mt-3">
                    <summary class="text-primary">Corriger le tarif</summary>
                    <form method="post" action="{{ path('colis_tarif', {id: colis.id}) }}" class="d-flex gap-2 mt-2">
                        {{ champRetour }}
                        <input type="hidden" name="_token" value="{{ csrf_token('tarif-colis-' ~ colis.id) }}">
                        <input type="number" step="0.01" min="0" name="frais" class="form-control" value="{{ (colis.frais / 100)|number_format(2, '.', '') }}" aria-label="Nouveau tarif">
                        <button class="btn btn-primary">OK</button>
                    </form>
                </details>
                {% endif %}
            </div>
        </div>

        {% if encaissement %}
        <div class="card border-primary">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-cash-register text-primary me-2"></i>Encaisser</h4></div>
            <div class="card-body">
                {{ form_start(encaissement) }}{{ champRetour }}
                    <div class="row g-2">
                        <div class="col-7">
                            {{ form_row(encaissement.montant) }}
                            {% if not is_granted('ROLE_RAMASSAGE') %}
                                {# Représentant : conversion en direct du montant saisi en francs CFA. #}
                                <small class="text-muted d-block mt-n2 mb-2" data-fcfa-pour="{{ encaissement.montant.vars.id }}" data-taux="{{ constant('App\\Twig\\AppExtension::EURO_EN_FCFA') }}"></small>
                            {% endif %}
                        </div>
                        <div class="col-5">{{ form_row(encaissement.remise) }}</div>
                    </div>
                    {{ form_row(encaissement.mode) }}
                    {{ form_row(encaissement.reference) }}
                    {{ form_row(encaissement.commentaire) }}
                    <button class="btn btn-primary w-100"><i class="fas fa-check me-1"></i> Enregistrer le paiement</button>
                {{ form_end(encaissement) }}
                {% if bonusDisponible > 0 %}
                <form method="post" action="{{ path('colis_bonus', {id: colis.id}) }}" class="mt-2" data-confirm="Le bonus disponible du client sera déduit du reste à payer de ce colis." data-confirm-titre="Utiliser le bonus fidélité ?" data-confirm-type="primary" data-confirm-bouton="Oui, utiliser le bonus">
                    {{ champRetour }}
                    <input type="hidden" name="_token" value="{{ csrf_token('bonus-colis-' ~ colis.id) }}">
                    <button class="btn btn-outline-info w-100"><i class="fas fa-gift me-1"></i> Utiliser le bonus ({{ bonusDisponible|money }})</button>
                </form>
                {% endif %}
            </div>
        </div>
        {% endif %}

        {% if peutLivrer and colis.statut.value != 'recupere' %}
        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-hand-holding text-primary me-2"></i>Agence</h4></div>
            <div class="card-body">
                {% if colis.statut.value == 'arrive' %}
                    <form method="post" action="{{ path('colis_remettre', {id: colis.id}) }}" data-confirm="Le colis sera marqué comme récupéré par le destinataire." data-confirm-titre="Remettre le colis ?" data-confirm-type="primary" data-confirm-bouton="Oui, remettre le colis">
                        {{ champRetour }}
                        <input type="hidden" name="_token" value="{{ csrf_token('remettre-colis-' ~ colis.id) }}">
                        <label class="form-label" for="code-retrait">Code de retrait présenté par le destinataire</label>
                        <input type="text" id="code-retrait" name="code" class="form-control mb-2 code-retrait text-uppercase" value="{{ app.request.query.get('code') }}" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="12" placeholder="Code reçu par SMS ou inscrit sur le reçu">
                        <label class="form-label" for="recuperePar">Remis à</label>
                        <input type="text" id="recuperePar" name="recuperePar" class="form-control mb-2" value="{{ colis.destinataireNom }}">
                        {% if is_granted('ROLE_ADMIN') %}
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="sansCode" value="1" id="sansCode"><label class="form-check-label" for="sansCode">Remettre sans code (admin, reçu perdu…) — noté dans l'historique</label></div>
                        {% endif %}
                        {% if not colis.solde %}
                            <div class="alert alert-warning py-2">Le colis n'est pas soldé : encaissez le reste avant la remise.</div>
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="forcer" value="1" id="forcer"><label class="form-check-label" for="forcer">Remettre quand même (admin)</label></div>
                            {% endif %}
                        {% endif %}
                        <button class="btn btn-success w-100" {{ not colis.solde and not is_granted('ROLE_ADMIN') ? 'disabled' }}><i class="fas fa-check-double me-1"></i> Remettre au destinataire</button>
                    </form>
                    <hr>
                {% endif %}
                <form method="post" action="{{ path('colis_statut', {id: colis.id}) }}">
                    {{ champRetour }}
                    <input type="hidden" name="_token" value="{{ csrf_token('statut-colis-' ~ colis.id) }}">
                    <label class="form-label" for="statut">Changer le statut</label>
                    <div class="d-flex gap-2">
                        <select name="statut" id="statut" class="form-select form-control">
                            {% for s in statuts %}<option value="{{ s.value }}" {{ s == colis.statut ? 'selected' }}>{{ s.label }}</option>{% endfor %}
                        </select>
                        <button class="btn btn-primary">OK</button>
                    </div>
                    <input type="text" name="commentaire" class="form-control mt-2" placeholder="Commentaire (facultatif)" aria-label="Commentaire">
                </form>
            </div>
        </div>
        {% endif %}

        <div class="card">
            <div class="card-header"><h4 class="card-title">Suivi</h4></div>
            <div class="card-body">
                {# Le représentant n'a pas à connaître les expéditions : seulement l'historique du colis. #}
                {% if not is_granted('ROLE_RAMASSAGE') %}
                {% elseif colis.expedition %}
                    <p class="mb-3"><i class="fas {{ colis.expedition.modeTransport.icone }} text-primary me-1"></i>
                        {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('expedition_show', {id: colis.expedition.id}) }}">{{ colis.expedition.numero }}</a>{% else %}{{ colis.expedition.numero }}{% endif %}
                        · {{ colis.expedition.destination.label }} · départ {{ colis.expedition.dateDepart|date('d/m/Y') }}</p>
                {% else %}
                    <p class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i> Pas encore affecté à une expédition.</p>
                {% endif %}
                <ul class="timeline-statut">
                    {% for h in colis.historique|reverse %}
                        <li><span class="point"></span>
                            <strong>{{ h.statut.label }}</strong> <small class="text-muted">· {{ h.date|date('d/m/Y H:i') }}</small>
                            {% if h.commentaire or h.auteur %}<div class="text-muted fs-13">{{ h.commentaire }}{% if h.auteur %} — {{ h.auteur.nomComplet }}{% endif %}</div>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
                <div class="qr-colis text-center mt-3">
                    <img src="{{ qr }}" alt="QR code de suivi du colis">
                    <div class="fs-12 text-muted">Lien de suivi public du destinataire</div>
                </div>
                <p class="fs-12 text-muted mt-3 mb-0">Enregistré par {{ colis.agent ? colis.agent.nomComplet : '—' }} le {{ colis.dateReception|date('d/m/Y à H:i') }}</p>
            </div>
        </div>
    </div>
</div>
{% include 'partials/_journal_fiche.html.twig' %}
{% include 'partials/_modal_etiquettes.html.twig' with {action: path('colis_etiquettes', {id: colis.id}), nombre: max(1, colis.nombreArticles), titre: 'Étiquettes du colis ' ~ colis.numeroSuivi} %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script nonce="{{ csp_nonce() }}">
    // Équivalent en francs CFA du montant saisi (représentants).
    document.querySelectorAll('[data-fcfa-pour]').forEach(function (aide) {
        var champ = document.getElementById(aide.dataset.fcfaPour), taux = parseFloat(aide.dataset.taux);
        if (!champ) { return; }
        var maj = function () {
            var euros = parseFloat(String(champ.value).replace(',', '.'));
            aide.textContent = isNaN(euros) ? '' : '≈ ' + Math.round(euros * taux).toLocaleString('fr-FR') + ' FCFA';
        };
        champ.addEventListener('input', maj);
        maj();
    });
    </script>
{% endblock %}
