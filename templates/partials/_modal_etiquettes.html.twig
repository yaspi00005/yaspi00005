{# Choix du format d'impression des étiquettes. Paramètres : action (URL du PDF), nombre (null = une par article de chaque colis), titre #}
<div class="modal fade" id="modal-etiquettes" tabindex="-1" aria-labelledby="modal-etiquettes-titre" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content js-form-etiquettes" method="get" action="{{ action }}" target="_blank" data-multi-submit>
            <div class="modal-header">
                <h5 class="modal-title" id="modal-etiquettes-titre"><i class="fas fa-tags text-primary me-2"></i>{{ titre }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="etiquettes-format">Format d'impression</label>
                <select name="format" id="etiquettes-format" class="form-control form-select mb-3 js-etiquettes-format">
                    {% for cle, f in constant('App\\Service\\Etiquettes::FORMATS') %}<option value="{{ cle }}">{{ f.libelle }}</option>{% endfor %}
                </select>
                {% if nombre is not null %}
                <label class="form-label" for="etiquettes-nombre">Nombre d'étiquettes</label>
                <input type="number" name="nombre" id="etiquettes-nombre" class="form-control mb-1" min="1" max="200" value="{{ nombre }}">
                <p class="fs-12 text-muted">Une par carton, valise ou sac : chaque étiquette est numérotée (« 1 / 3 », « 2 / 3 »…).</p>
                {% endif %}
                <div class="js-etiquettes-debut d-none">
                    <label class="form-label" for="etiquettes-debut">Planche déjà entamée : commencer à la position</label>
                    <select name="debut" id="etiquettes-debut" class="form-control form-select mb-1">
                        <option value="1">1 — en haut à gauche</option>
                        <option value="2">2 — en haut à droite</option>
                        <option value="3">3 — en bas à gauche</option>
                        <option value="4">4 — en bas à droite</option>
                    </select>
                </div>
                <p class="fs-12 text-muted mb-0 mt-2"><i class="fas fa-print me-1"></i> À l'impression, choisissez « Taille réelle » (100 %), sans mise à l'échelle.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                <button class="btn btn-primary"><i class="fas fa-print me-1"></i> Imprimer</button>
            </div>
        </form>
    </div>
</div>
