{% extends 'base_simple.html.twig' %}

{% block title %}Connexion · {{ app_nom }}{% endblock %}

{% block body %}
    <h4 class="text-center mb-4">Connectez-vous à votre espace</h4>
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    <form method="post" action="{{ path('app_login') }}">
        <div class="mb-3">
            <label class="mb-1 form-label" for="username"><strong>Identifiant</strong></label>
            <input type="text" id="username" name="_username" class="form-control" value="{{ last_username }}" autocomplete="username" required autofocus>
        </div>
        <div class="mb-3">
            <label class="mb-1 form-label" for="password"><strong>Mot de passe</strong></label>
            <input type="password" id="password" name="_password" class="form-control" autocomplete="current-password" required>
        </div>
        <div class="mb-3">
            <div class="form-check custom-checkbox ms-1">
                <input type="checkbox" class="form-check-input" id="remember_me" name="_remember_me" checked>
                <label class="form-check-label" for="remember_me">Rester connecté 7 jours</label>
            </div>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <div class="text-center">
            <button type="submit" class="btn btn-primary btn-block w-100">Se connecter</button>
        </div>
    </form>
    <div class="new-account mt-4 text-center">
        <p class="mb-2">Vous attendez un colis ? <a class="text-primary" href="{{ path('suivi_recherche') }}">Suivre mon colis</a></p>
        <p class="mb-0"><a class="text-muted" href="{{ path('app_application') }}"><i class="fab fa-android me-1"></i>Application Android</a></p>
    </div>
{% endblock %}
