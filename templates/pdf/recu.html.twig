<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
    @page { margin: 28px 32px; }
    body { font-family: 'DejaVu Sans', sans-serif; font-size: 11px; color: #222; }
    .vert { color: #00A15D; }
    h1 { font-size: 20px; margin: 0; }
    table { width: 100%; border-collapse: collapse; }
    .entete td { vertical-align: top; }
    .bloc { border: 1px solid #ddd; border-radius: 6px; padding: 8px 10px; }
    .titre { font-size: 9px; text-transform: uppercase; color: #777; letter-spacing: .5px; margin-bottom: 3px; }
    .articles th { background: #00A15D; color: #fff; padding: 6px; text-align: left; font-size: 10px; }
    .articles td { border-bottom: 1px solid #eee; padding: 6px; }
    .num { text-align: right; white-space: nowrap; }
    .totaux td { padding: 4px 6px; }
    .code { font-size: 22px; font-weight: bold; letter-spacing: 4px; }
    .photos img { width: 120px; height: 120px; object-fit: cover; border-radius: 4px; }
    .petit { font-size: 9px; color: #777; }
</style>
</head>
<body>
<table class="entete">
    <tr>
        <td>
            {% if logo_data_uri() %}<img src="{{ logo_data_uri() }}" alt="" style="height:70px;float:left;margin-right:12px">{% endif %}
            <h1 class="vert">{{ app_nom }}</h1>
            <div class="petit">Reçu de dépôt de colis</div>
            <div class="petit" style="margin-top:3px">Tél. / WhatsApp : <strong style="color:#222">{{ societe.telephone }}</strong>{% if societe.email|default(null) %} · {{ societe.email }}{% endif %}{% if societe.site|default(null) %} · {{ societe.site }}{% endif %}</div>
        </td>
        <td style="text-align:right">
            <div class="titre">N° de suivi</div>
            <div style="font-size:18px;font-weight:bold">{{ colis.numeroSuivi }}</div>
            <div class="petit">Déposé le {{ colis.dateReception|date('d/m/Y à H:i') }}</div>
        </td>
    </tr>
</table>
<br>
<table>
    <tr>
        <td style="width:37%;padding-right:8px;vertical-align:top">
            <div class="bloc">
                <div class="titre">Expéditeur</div>
                <strong>{{ colis.client.nomComplet }}</strong><br>
                {{ colis.client.telephone }}<br>
                {{ colis.client.adresse }} {{ colis.client.codePostal }} {{ colis.client.ville }}
            </div>
        </td>
        <td style="width:37%;padding-right:8px;vertical-align:top">
            <div class="bloc">
                <div class="titre">Destinataire</div>
                <strong>{{ colis.destinataireNom }}</strong><br>
                {{ colis.destinataireTelephone }}<br>
                {% if colis.expedition %}{{ colis.expedition.destination.label }} — {{ colis.expedition.modeTransport.label }}, départ {{ colis.expedition.dateDepart|date('d/m/Y') }}{% endif %}
            </div>
        </td>
        <td style="width:26%;text-align:center;vertical-align:top">
            <img src="{{ qr }}" style="width:110px;height:110px" alt="QR">
            <div class="petit">Scannez pour suivre le colis</div>
        </td>
    </tr>
</table>
<br>
<table class="articles">
    <thead><tr><th>#</th><th>Marchandise</th><th>Observations</th><th class="num">Colis</th><th class="num">Prix</th></tr></thead>
    <tbody>
    {% for a in colis.articles %}
        <tr><td>{{ loop.index }}</td><td>{{ a.typeMarchandise }}</td><td>{{ a.observations }}</td><td class="num">{{ a.quantite }}</td><td class="num">{{ a.prix|money }}{% if fcfa|default(false) %}<br><span class="petit">≈ {{ a.prix|fcfa }}</span>{% endif %}</td></tr>
    {% endfor %}
    </tbody>
</table>
<br>
<table>
    <tr>
        <td style="width:55%;vertical-align:top">
            <div class="bloc" style="text-align:center">
                <div class="titre">Code de retrait à présenter à l'agence</div>
                {% if masquerCode|default(false) %}
                <div class="code vert">••••••</div>
                <div class="petit">Le destinataire présente le code reçu par SMS ou inscrit sur son reçu.</div>
                {% else %}
                <div class="code vert">{{ colis.codeRetrait }}</div>
                <div class="petit">Ne communiquez ce code qu'au destinataire du colis.</div>
                {% endif %}
            </div>
            <p class="petit">Suivi en ligne : {{ lien }}</p>
            {% if bonusGagne > 0 or colis.client.soldeBonus > 0 %}
            <div class="bloc" style="margin-top:6px">
                <div class="titre">Bonus fidélité</div>
                {% if bonusGagne > 0 %}Ce colis vous rapporte <strong class="vert">{{ bonusGagne|money }}</strong>.<br>{% endif %}
                Vous avez cumulé <strong>{{ colis.client.soldeBonus|money }}</strong> de bonus, déductibles de vos prochains envois.
            </div>
            {% endif %}
        </td>
        <td style="width:45%;vertical-align:top;padding-left:10px">
            <table class="totaux">
                <tr><td>Nombre de colis</td><td class="num">{{ colis.nombreArticles }}</td></tr>
                {% set f = fcfa|default(false) %}
                <tr><td>Tarif</td><td class="num">{{ colis.frais|money }}{% if f %}<br><span class="petit">≈ {{ colis.frais|fcfa }}</span>{% endif %}</td></tr>
                {% if colis.remise %}<tr><td>Remises</td><td class="num">− {{ colis.remise|money }}{% if f %}<br><span class="petit">≈ {{ colis.remise|fcfa }}</span>{% endif %}</td></tr>{% endif %}
                <tr><td>Déjà payé</td><td class="num">{{ colis.montantPaye|money }}{% if f %}<br><span class="petit">≈ {{ colis.montantPaye|fcfa }}</span>{% endif %}</td></tr>
                <tr><td style="font-size:14px"><strong>Reste à payer</strong></td><td class="num" style="font-size:14px"><strong>{{ colis.montantRestant|money }}</strong>{% if f %}<br><strong style="font-size:12px">≈ {{ colis.montantRestant|fcfa }}</strong>{% endif %}</td></tr>
                {% if f %}<tr><td colspan="2" class="petit" style="text-align:right">1 € = 655,957 FCFA</td></tr>{% endif %}
            </table>
        </td>
    </tr>
</table>
{% if photos %}
<br>
<div class="titre">Photos des articles</div>
<table class="photos"><tr>
    {% for p in photos|slice(0, 4) %}
        <td style="width:25%;text-align:center;vertical-align:top"><img src="{{ p.uri }}" alt=""><div class="petit">{{ p.legende }}</div></td>
    {% endfor %}
</tr></table>
{% endif %}
<br>
<table><tr>
    <td class="petit" style="width:50%">Signature de l'agent : {{ colis.agent ? colis.agent.nomComplet }}<br><br>______________________</td>
    <td class="petit" style="width:50%;text-align:right">Signature du client<br><br>______________________</td>
</tr></table>
<div style="margin-top:14px;border-top:1px solid #ddd;padding-top:6px;text-align:center" class="petit">
    <strong class="vert">{{ app_nom }}</strong> · Transport de colis France → Bamako (Mali) · Dakar (Sénégal)<br>
    {% for p in societe.equipe|default([]) %}{{ p.nom }} : {{ p.telephone }}{{ not loop.last ? ' · ' }}{% endfor %}<br>
    {% if societe.email|default(null) %}{{ societe.email }}{% endif %}{% if societe.site|default(null) %} · Suivi de colis et infos : {{ societe.site }}{% endif %}{% for r in societe.reseaux|default([]) %} · {{ r.nom }} {{ r.compte }}{% endfor %}
</div>
</body>
</html>
