<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
    @page { margin: 26px 30px 40px; }
    body { font-family: 'DejaVu Sans', sans-serif; font-size: 10px; color: #222; }
    .vert { color: #00A15D; }
    h1 { font-size: 18px; margin: 0; }
    .petit { font-size: 9px; color: #777; }
    table { width: 100%; border-collapse: collapse; }
    .liste th { background: #00A15D; color: #fff; padding: 6px; text-align: left; font-size: 9px; }
    .liste td { border-bottom: 1px solid #e5e5e5; padding: 6px; vertical-align: top; }
    .liste tr.jour td { background: #f2f8f5; font-weight: bold; color: #00A15D; border-bottom: 1px solid #cfe6da; }
    .badge { display: inline-block; padding: 2px 6px; border-radius: 8px; font-size: 8px; font-weight: bold; }
    .badge-warning { background: #fff3d6; color: #b07800; }
    .badge-success { background: #dff5e7; color: #0a7a35; }
    .badge-danger { background: #fde2e2; color: #b3261e; }
    .badge-info { background: #f7e3f4; color: #9c2f8a; }
    .resume td { padding: 2px 10px 2px 0; }
    .coche { width: 14px; height: 14px; border: 1px solid #999; display: inline-block; }
    .pied { position: fixed; bottom: -26px; left: 0; right: 0; font-size: 8px; color: #999; }
</style>
</head>
<body>
<div class="pied">{{ app_nom }} — Planning des ramassages — édité le {{ genereLe|date('d/m/Y à H:i') }}{% if app.user %} par {{ app.user.nomComplet }}{% endif %} · Tél. / WhatsApp {{ societe.telephone }}{% if societe.email|default(null) %} · {{ societe.email }}{% endif %}</div>
<table>
    <tr>
        <td>
            {% if logo_data_uri() %}<img src="{{ logo_data_uri() }}" alt="" style="height:62px;float:left;margin-right:12px">{% endif %}
            <h1 class="vert">{{ app_nom }}</h1>
            <div style="font-size:14px;font-weight:bold;margin-top:4px">
                Planning des ramassages{% if statut %} — {{ statut.label }}{% endif %}
            </div>
            <div class="petit">
                {% if du and au %}Du {{ du|date('d/m/Y') }} au {{ au|date('d/m/Y') }}
                {% elseif du %}À partir du {{ du|date('d/m/Y') }}
                {% elseif au %}Jusqu'au {{ au|date('d/m/Y') }}
                {% else %}Toutes dates{% endif %}
            </div>
        </td>
        <td style="text-align:right;vertical-align:top">
            <table class="resume" style="width:auto;margin-left:auto">
                <tr><td><strong>{{ ramassages|length }}</strong> ramassage(s)</td></tr>
                {% if not statut %}
                    {% for libelle, n in parStatut %}<tr><td class="petit">{{ libelle }} : {{ n }}</td></tr>{% endfor %}
                {% endif %}
            </table>
        </td>
    </tr>
</table>
<br>
<table class="liste">
    <thead>
        <tr>
            <th style="width:6%">Heure</th>
            <th style="width:17%">Client</th>
            <th style="width:11%">Téléphone</th>
            <th style="width:25%">Adresse</th>
            <th style="width:12%">Agent</th>
            <th style="width:17%">Commentaire</th>
            <th style="width:8%">Statut</th>
            {% if not statut or statut.estAFaire %}<th style="width:4%">Fait</th>{% endif %}
        </tr>
    </thead>
    <tbody>
    {% set jourPrecedent = null %}
    {% for r in ramassages %}
        {% set jour = r.datePrevue|jour_fr %}
        {% if jour != jourPrecedent %}
            <tr class="jour"><td colspan="8">{{ jour|capitalize }}</td></tr>
            {% set jourPrecedent = jour %}
        {% endif %}
        <tr>
            <td>{{ r.datePrevue|date('H:i') }}</td>
            <td><strong>{{ r.client.nomComplet }}</strong></td>
            <td>{{ r.client.telephone|tel }}</td>
            <td>{{ r.adresse ?: (r.client.adresse ~ ' ' ~ r.client.codePostal ~ ' ' ~ r.client.ville) }}</td>
            <td>{{ r.agent ? r.agent.nomComplet : '—' }}</td>
            <td>{{ r.commentaire }}</td>
            <td><span class="badge badge-{{ r.statut.badge }}">{{ r.statut.value == 'confirme' ? '✔ Confirmé' : r.statut.label }}</span></td>
            {% if not statut or statut.estAFaire %}<td style="text-align:center">{% if r.statut.estAFaire %}<span class="coche"></span>{% endif %}</td>{% endif %}
        </tr>
    {% else %}
        <tr><td colspan="8" style="text-align:center;padding:30px;color:#999">Aucun ramassage pour ces critères.</td></tr>
    {% endfor %}
    </tbody>
</table>
</body>
</html>
