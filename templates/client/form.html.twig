{% extends 'base.html.twig' %}

{% block title %}{{ client.id ? 'Modifier ' ~ client.nomComplet : 'Nouveau client' }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header"><h4 class="card-title">{{ block('title') }}</h4></div>
            <div class="card-body">
                {{ form_start(form, {attr: {'data-villes-url': path('client_villes'), 'data-geocoder-url': path('client_geocoder')}}) }}
                {% if semblables|default([]) %}
                <div class="alert alert-warning">
                    <h5 class="alert-heading"><i class="fas fa-user-friends me-1"></i> Ce client existe peut-être déjà</h5>
                    <p class="mb-2">Même numéro de téléphone ou mêmes nom et prénom :</p>
                    <ul class="list-unstyled mb-3">
                        {% for s in semblables %}
                            <li class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-1 border-bottom">
                                <span><strong>{{ s.nomComplet }}</strong> · {{ s.telephone|tel }}{% if s.ville %} · {{ s.ville }}{% endif %}</span>
                                {% if app.request.query.get('retour') == 'colis' %}
                                    <a href="{{ path('colis_new', {client: s.id}) }}" class="btn btn-primary btn-xs">Utiliser ce client</a>
                                {% else %}
                                    <a href="{{ path('client_show', {id: s.id}) }}" class="btn btn-primary btn-xs">Voir ce client</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" name="confirmer_doublon" value="1" class="btn btn-warning btn-sm"><i class="fas fa-plus me-1"></i> Créer quand même un nouveau client</button>
                        <a href="{{ path('client_index') }}" class="btn btn-light btn-sm">Annuler</a>
                    </div>
                </div>
                {% endif %}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.prenom) }}</div>
                    <div class="col-md-6">{{ form_row(form.nom) }}</div>
                    <div class="col-md-6">{{ form_row(form.telephone) }}</div>
                    <div class="col-md-6">{{ form_row(form.email) }}</div>
                    <div class="col-12">{{ form_row(form.adresse) }}</div>
                    <div class="col-md-4">{{ form_row(form.pays) }}</div>
                    <div class="col-md-3">{{ form_row(form.codePostal) }}</div>
                    <div class="col-md-5">
                        {{ form_row(form.ville) }}
                        <datalist id="villes-cp"></datalist>
                    </div>
                    <div class="col-12">
                        <div class="geo-bloc mb-3 js-geo">
                            <label class="form-label d-block"><i class="fas fa-location-arrow text-primary me-1"></i> Position GPS du domicile</label>
                            <p class="fs-13 mb-2 js-geo-etat">
                                {% if client.hasPosition %}
                                    Position enregistrée {{ client.positionSource == 'gps' ? 'sur place (GPS)' : 'à partir de l\'adresse' }}.
                                {% else %}
                                    Aucune position : utilisez le GPS du téléphone chez le client, ou localisez l'adresse.
                                {% endif %}
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-primary btn-sm js-geo-gps"><i class="fas fa-crosshairs me-1"></i> Ma position actuelle</button>
                                <button type="button" class="btn btn-outline-primary btn-sm js-geo-adresse"><i class="fas fa-search-location me-1"></i> Localiser l'adresse</button>
                                <button type="button" class="btn btn-light btn-sm js-geo-effacer {{ client.hasPosition ? '' : 'd-none' }}"><i class="fas fa-times me-1"></i> Effacer</button>
                            </div>
                            <iframe class="geo-carte mt-2 {{ client.hasPosition ? '' : 'd-none' }}" title="Carte" data-src="{{ carte_osm(client.latitude, client.longitude) }}" src="about:blank"></iframe>
                            {{ form_widget(form.latitude) }}{{ form_widget(form.longitude) }}{{ form_widget(form.positionSource) }}
                            {{ form_errors(form.latitude) }}{{ form_errors(form.longitude) }}{{ form_errors(form.positionSource) }}
                        </div>
                    </div>
                    <div class="col-12">{{ form_row(form.notes) }}</div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ client.id ? path('client_show', {id: client.id}) : path('client_index') }}" class="btn btn-light">Annuler</a>
                    <button class="btn btn-primary"><i class="fas fa-check me-1"></i> Enregistrer</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
