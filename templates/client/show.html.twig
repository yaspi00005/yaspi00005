{% extends 'base.html.twig' %}

{% block title %}{{ client.nomComplet }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-xl-4">
        <div class="card">
            <div class="card-body text-center">
                <span class="avatar-initiales mb-3" style="width:5rem;height:5rem;font-size:1.8rem">{{ client.initiales }}</span>
                <h4 class="mb-1">{{ client.nomComplet }}</h4>
                <p class="text-muted mb-3">Client depuis le {{ client.createdAt|date('d/m/Y') }}</p>
                <div class="text-start">
                    <p class="mb-2"><i class="fas fa-phone-alt text-primary me-2"></i><a href="tel:{{ client.telephone }}">{{ client.telephone|tel }}</a></p>
                    {% if client.email %}<p class="mb-2"><i class="fas fa-envelope text-primary me-2"></i><a href="mailto:{{ client.email }}">{{ client.email }}</a></p>{% endif %}
                    <p class="mb-2"><i class="fas fa-map-marker-alt text-primary me-2"></i>{{ client.adresse ? client.adresse ~ ', ' }}{{ client.codePostal }} {{ client.ville }} {{ client.pays }}</p>
                    {% if client.notes %}<p class="mb-2 text-muted"><i class="fas fa-sticky-note text-primary me-2"></i>{{ client.notes }}</p>{% endif %}
                </div>
                <div class="d-flex gap-2 justify-content-center mt-3 flex-wrap">
                    <a href="{{ path('colis_new', {client: client.id}) }}" class="btn btn-primary btn-rounded btn-sm"><i class="fas fa-box me-1"></i> Nouveau colis</a>
                    <a href="{{ path('ramassage_new', {client: client.id}) }}" class="btn btn-primary light btn-rounded btn-sm"><i class="fas fa-calendar-plus me-1"></i> Ramassage</a>
                    <a href="{{ path('client_edit', {id: client.id}) }}" class="btn btn-light btn-rounded btn-sm"><i class="fas fa-pen me-1"></i> Modifier</a>
                </div>
                {% if is_granted('ROLE_ADMIN') and client.colis is empty %}
                <form method="post" action="{{ path('client_delete', {id: client.id}) }}" class="mt-3" data-confirm="Supprimer ce client ?">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-client-' ~ client.id) }}">
                    <button class="btn btn-link text-danger btn-sm">Supprimer le client</button>
                </form>
                {% endif %}
            </div>
        </div>

        {% set nav = itineraire(client) %}
        <div class="card js-geo-fiche" data-url="{{ path('client_position', {id: client.id}) }}" data-token="{{ csrf_token('position-client') }}">
            <div class="card-header">
                <h4 class="card-title"><i class="fas fa-map-marked-alt text-primary me-2"></i>Localisation</h4>
                {% if client.hasPosition %}<span class="badge badge-{{ client.positionSource == 'gps' ? 'success' : 'info' }} light">{{ client.positionSource == 'gps' ? 'GPS' : 'Adresse' }}</span>{% endif %}
            </div>
            <div class="card-body pt-0">
                {% if client.hasPosition %}
                    <iframe class="geo-carte" title="Carte : domicile de {{ client.nomComplet }}" data-src="{{ carte_osm(client.latitude, client.longitude) }}" src="about:blank"></iframe>
                    <p class="fs-12 text-muted mt-1 mb-2">{{ client.latitude|number_format(5, '.') }}, {{ client.longitude|number_format(5, '.') }}{% if client.positionMajLe %} · relevée le {{ client.positionMajLe|date('d/m/Y') }}{% endif %}</p>
                {% else %}
                    <p class="text-muted fs-13">Position GPS non enregistrée{{ nav ? ' : l\'itinéraire utilise l\'adresse' }}.</p>
                {% endif %}
                <div class="d-flex flex-wrap gap-2">
                    {% if nav %}
                        <a href="{{ nav }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm"><i class="fas fa-route me-1"></i> Itinéraire</a>
                        <a href="{{ itineraire(client, null, 'waze') }}" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm"><i class="fab fa-waze me-1"></i> Waze</a>
                    {% endif %}
                    <button type="button" class="btn btn-light btn-sm js-geo-ici"><i class="fas fa-crosshairs me-1"></i> Je suis chez le client</button>
                </div>
                <p class="fs-12 text-muted mt-2 mb-0">« Je suis chez le client » enregistre la position GPS de votre téléphone comme domicile du client.</p>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h4 class="card-title"><i class="fas fa-gift text-primary me-2"></i>Bonus fidélité</h4>
                <strong class="fs-20 text-primary">{{ client.soldeBonus|money }}</strong>
            </div>
            <div class="card-body pt-0">
                {% if bonusForm %}
                    {{ form_start(bonusForm) }}
                        {{ form_row(bonusForm.sens) }}
                        <div class="row g-2">
                            <div class="col-5">{{ form_row(bonusForm.montant) }}</div>
                            <div class="col-7">{{ form_row(bonusForm.libelle) }}</div>
                        </div>
                        <button class="btn btn-primary btn-sm w-100">Valider</button>
                    {{ form_end(bonusForm) }}
                {% endif %}
                <ul class="list-unstyled mt-3 mb-0">
                    {% for m in client.mouvementsBonus|slice(0, 10) %}
                        <li class="d-flex justify-content-between border-bottom py-2">
                            <span>{{ m.libelle }}<br><small class="text-muted">{{ m.createdAt|date('d/m/Y') }}</small></span>
                            <strong class="{{ m.credit ? 'text-success' : 'text-danger' }}">{{ m.credit ? '+' : '−' }}{{ (m.montant|abs)|money }}</strong>
                        </li>
                    {% else %}
                        <li class="text-muted">Aucun mouvement.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card">
            <div class="card-header"><h4 class="card-title">Colis envoyés ({{ client.colis|length }})</h4></div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>N° suivi</th><th>Destinataire</th><th class="num">Montant</th><th class="num">Reste</th><th>Statut</th></tr></thead>
                        <tbody>
                        {% for c in client.colis %}
                            <tr>
                                <td><a href="{{ path('colis_show', {id: c.id}) }}" class="text-primary font-w600">{{ c.numeroSuivi }}</a><br><small class="text-muted">{{ c.dateReception|date('d/m/Y') }}</small></td>
                                <td>{{ c.destinataireNom }}<br><small class="text-muted">{{ c.destinataireTelephone|tel }}</small></td>
                                <td class="num">{{ c.montantNet|money }}</td>
                                <td class="num {{ c.montantRestant ? 'text-danger' }}">{{ c.montantRestant|money }}</td>
                                <td>{% include 'partials/_badge.html.twig' with {statut: c.statut} %}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5"><div class="empty-state"><i class="fas fa-box-open"></i>Aucun colis pour ce client.</div></td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% include 'partials/_journal_fiche.html.twig' %}
{% endblock %}
