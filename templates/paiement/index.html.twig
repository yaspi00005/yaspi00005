{% extends 'base.html.twig' %}

{% block title %}Paiements{% endblock %}

{% block body %}
<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 filtres">
            <div class="col-6 col-md-2"><label class="form-label fs-12 mb-1" for="du">Du</label><input type="date" id="du" name="du" value="{{ filtres.du }}" class="form-control"></div>
            <div class="col-6 col-md-2"><label class="form-label fs-12 mb-1" for="au">Au</label><input type="date" id="au" name="au" value="{{ filtres.au }}" class="form-control"></div>
            <div class="col-6 col-md-2"><label class="form-label fs-12 mb-1" for="mode">Mode</label>
                <select name="mode" id="mode" class="form-select form-control"><option value="">Tous</option>
                    {% for m in modes %}<option value="{{ m.value }}" {{ filtres.mode == m.value ? 'selected' }}>{{ m.label }}</option>{% endfor %}
                </select></div>
            <div class="col-6 col-md-2"><label class="form-label fs-12 mb-1" for="caissier">Caissier</label>
                <select name="caissier" id="caissier" class="form-select form-control"><option value="">Tous</option>
                    {% for u in caissiers %}<option value="{{ hid(u.id) }}" {{ filtres.caissier == u.id ? 'selected' }}>{{ u.nomComplet }}</option>{% endfor %}
                </select></div>
            <div class="col-md-2"><label class="form-label fs-12 mb-1" for="expedition">Expédition</label>
                <select name="expedition" id="expedition" class="form-select form-control"><option value="">Toutes</option>
                    {% for e in expeditions %}<option value="{{ hid(e.id) }}" {{ filtres.expedition == e.id ? 'selected' }}>{{ e.numero }} · {{ e.destination.label }}</option>{% endfor %}
                </select></div>
            <div class="col-md-2 d-flex align-items-end gap-1">
                <button class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i> Filtrer</button>
                <a href="?{{ app.request.query.all|merge({export: 'csv', page: null})|url_encode }}" class="btn btn-outline-primary" title="Export Excel" aria-label="Export Excel"><i class="fas fa-file-excel"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-sm-6">
        <div class="card stat-card"><div class="card-body d-flex align-items-center gap-3">
            <span class="stat-icon bgl-success text-success"><i class="fas fa-euro-sign"></i></span>
            <div><div class="stat-value">{{ total|money }}</div><span class="text-muted fs-14">Encaissé sur la période</span></div>
        </div></div>
    </div>
    {% for mode, montant in parMode|filter(v => v > 0) %}
    <div class="col-xl-3 col-sm-6">
        <div class="card stat-card"><div class="card-body d-flex align-items-center gap-3">
            <span class="stat-icon bgl-primary text-primary"><i class="fas fa-wallet"></i></span>
            <div><div class="stat-value">{{ montant|money }}</div><span class="text-muted fs-14">{{ enum('App\\Enum\\ModePaiement').from(mode).label }}</span></div>
        </div></div>
    </div>
    {% endfor %}
</div>

<div class="row">
    <div class="col-xl-9">
        <div class="card">
            <div class="card-header"><h4 class="card-title">{{ paiements.total }} opérations</h4></div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Date</th><th>Colis</th><th>Client</th><th>Mode</th><th class="num">Montant</th><th class="num">Remise</th><th>Caissier</th></tr></thead>
                        <tbody>
                        {% for p in paiements %}
                            <tr>
                                <td>{{ p.date|date('d/m/Y H:i') }}</td>
                                <td><a href="{{ path('colis_show', {id: p.colis.id}) }}" class="text-primary">{{ p.colis.numeroSuivi }}</a></td>
                                <td>{{ p.colis.client.nomComplet }}</td>
                                <td>{{ p.mode.label }}{% if p.reference %}<br><small class="text-muted">{{ p.reference }}</small>{% endif %}</td>
                                <td class="num font-w600">{{ p.montant|money }}</td>
                                <td class="num">{{ p.remise ? p.remise|money : '—' }}</td>
                                <td>{{ p.caissier ? p.caissier.nomComplet : '—' }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7"><div class="empty-state"><i class="fas fa-wallet"></i>Aucun paiement sur cette période.</div></td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% include 'partials/_pagination.html.twig' with {pagination: paiements} %}
            </div>
        </div>
    </div>
    <div class="col-xl-3">
        <div class="card">
            <div class="card-header"><h4 class="card-title">Par caissier</h4></div>
            <div class="card-body">
                {% for c in parCaissier %}
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>{{ c.caissier }}<br><small class="text-muted">{{ c.nb }} opération(s)</small></span>
                        <strong>{{ c.total|money }}</strong>
                    </div>
                {% else %}<span class="text-muted">—</span>{% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
