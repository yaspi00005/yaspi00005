{% extends 'base.html.twig' %}

{% block title %}Camions{% endblock %}

{% block body %}
<div class="row">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header"><h4 class="card-title">{{ camions|length }} camion{{ camions|length > 1 ? 's' }}</h4></div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Camion</th><th>Immatriculation</th><th>Volume</th><th>Chauffeur habituel</th><th>État</th><th></th></tr></thead>
                        <tbody>
                        {% for c in camions %}
                            <tr>
                                <td class="font-w600"><span class="pastille-camion" style="background: {{ c.couleur }}"></span>{{ c.nom }}</td>
                                <td>{{ c.immatriculation ?: '—' }}</td>
                                <td>{{ c.volume ?: '—' }}</td>
                                <td>{{ c.chauffeur ? c.chauffeur.nomComplet : '—' }}</td>
                                <td><span class="badge light badge-{{ c.actif ? 'success' : 'dark' }}">{{ c.actif ? 'En service' : 'Retiré' }}</span></td>
                                <td class="text-end"><a href="{{ path('admin_camion_edit', {id: c.id}) }}" class="btn btn-primary shadow btn-xs sharp" title="Modifier" aria-label="Modifier {{ c.nom }}"><i class="fas fa-pencil-alt"></i></a></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6"><div class="empty-state"><i class="fas fa-truck"></i>Aucun camion : ajoutez vos véhicules (Sprinter, Boxer, 20 m³…).</div></td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header"><h4 class="card-title">Ajouter un camion</h4></div>
            <div class="card-body">
                {{ form_start(form) }}{{ form_rest(form) }}
                <button class="btn btn-primary w-100">Ajouter</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
