{% extends 'base.html.twig' %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-9">
        <div class="card">
            <div class="card-body">
                {% if element.video is defined and element.video %}
                <div class="mb-3">
                    <video controls playsinline preload="metadata" class="apercu-video-admin"{% if element.apercu %} poster="{{ asset(element.apercu) }}"{% endif %}><source src="{{ asset(element.video) }}" type="{{ element.typeVideo }}"></video>
                </div>
                {% elseif element.apercu is defined and element.apercu %}
                <img src="{{ asset(element.apercu) }}" alt="" class="apercu-image-admin mb-3">
                {% endif %}
                {% if element.photo is defined and element.photo %}
                <img src="{{ asset(element.photo) }}" alt="" class="apercu-image-admin mb-3">
                {% endif %}
                {% if element.logo is defined and element.logo %}
                <img src="{{ asset(element.logo) }}" alt="" class="logo-partenaire-admin grand mb-3">
                {% endif %}
                {{ form_start(form) }}{{ form_rest(form) }}
                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('admin_site_index') }}" class="btn btn-light">Annuler</a>
                    <button class="btn btn-primary"><i class="fas fa-save me-1"></i> Enregistrer</button>
                </div>
                {{ form_end(form) }}
                {% if suppression %}
                <form method="post" action="{{ path(suppression, {id: element.id}) }}" class="border-top mt-3 pt-3 text-end" data-confirm="Cet élément disparaîtra du site (et ses fichiers du serveur)." data-confirm-titre="Supprimer ?" data-confirm-type="danger" data-confirm-bouton="Supprimer">
                    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-site-' ~ element.id) }}">
                    <button class="btn btn-outline-danger btn-sm"><i class="fas fa-trash me-1"></i> Supprimer</button>
                </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
