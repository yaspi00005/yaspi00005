{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="row">
    <div class="col-xl-4">
        <div class="card">
            <div class="card-body text-center">
                <span class="avatar-initiales mb-3" style="width:5rem;height:5rem;font-size:1.8rem">{{ app.user.initiales }}</span>
                <h4 class="mb-1">{{ app.user.nomComplet }}</h4>
                <p class="text-muted mb-1">{{ app.user.roleLabel }}{% if app.user.pays %} · {{ app.user.pays.label }}{% endif %}</p>
                <p class="text-muted mb-0">Identifiant : <strong>{{ app.user.userIdentifier }}</strong></p>
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-bell text-primary me-2"></i>Notifications</h4></div>
            <div class="card-body">
                <p class="mb-2">Les rappels des ramassages sont envoyés <strong>la veille</strong> puis <strong>environ 1 h avant</strong>, à l'agent assigné (ou à tous les agents de ramassage si personne n'est assigné) :</p>
                <ul class="mb-3">
                    <li>par <strong>e-mail</strong> : {{ app.user.email ?: '— aucune adresse enregistrée, demandez à un administrateur de l\'ajouter' }}</li>
                    <li>par <strong>notification du navigateur</strong> : {{ nbNavigateurs }} navigateur(s) abonné(s).</li>
                </ul>
                {% if push_cle_publique %}
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-primary js-push-bouton d-none"><i class="fas fa-bell me-1"></i> <span class="js-push-libelle">Activer les notifications</span></button>
                        <button type="button" class="btn btn-outline-primary js-push-tester d-none"><i class="fas fa-paper-plane me-1"></i> Envoyer une notification de test</button>
                    </div>
                    <p class="fs-12 text-muted mt-2 mb-0 js-push-etat"></p>
                {% else %}
                    <div class="alert alert-warning mb-0">
                        Les notifications du navigateur ne sont pas encore configurées sur ce serveur.
                        {% if is_granted('ROLE_ADMIN') %}
                            <br>Sur le serveur, dans le dossier de l'application, lancez une seule fois :
                            <code class="d-block mt-2">php bin/console app:generer-cles-push --ecrire<br>php bin/console cache:clear</code>
                        {% else %}
                            Prévenez un administrateur.
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h4 class="card-title">Changer mon mot de passe</h4></div>
            <div class="card-body">
                {{ form_start(form) }}
                {{ form_rest(form) }}
                <button class="btn btn-primary">Enregistrer</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
