{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% macro stat(icone, couleur, valeur, libelle, url) %}
    <div class="col-xl-3 col-6">
        <a href="{{ url }}" class="card stat-card text-decoration-none">
            <div class="card-body d-flex flex-column flex-sm-row align-items-sm-center gap-2 gap-sm-3">
                <span class="stat-icon bgl-{{ couleur }} text-{{ couleur }}"><i class="{{ icone }}"></i></span>
                <div>
                    <div class="stat-value">{{ valeur }}</div>
                    <span class="text-muted fs-14">{{ libelle }}</span>
                </div>
            </div>
        </a>
    </div>
{% endmacro %}
{% import _self as m %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card bg-primary text-white overflow-hidden">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h3 class="text-white mb-1">Bonjour {{ app.user.prenom }} 👋</h3>
                    <p class="mb-0 opacity-75">
                        {% if estRamassage %}
                            Vous avez enregistré {{ totalColis }} colis{% if performance %}, dont {{ performance.mois.nb }} ce mois-ci{% endif %}.
                        {% else %}
                            {{ totalColis }} colis {{ estRepresentant ? 'arrivés' : 'suivis' }}{% if estRepresentant and app.user.pays %} au {{ app.user.pays.label }}{% endif %}
                            · {{ enAttenteRetrait }} arrivés depuis plus de 7 jours sans être retirés.
                        {% endif %}
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    {% if is_granted('ROLE_REPRESENTANT') %}
                        <a href="{{ path('agence_guichet') }}" class="btn bg-white btn-rounded text-primary font-w600"><i class="fas fa-qrcode me-1"></i> Guichet</a>
                    {% endif %}
                    {% if is_granted('ROLE_RAMASSAGE') %}
                        <a href="{{ path('colis_new') }}" class="btn bg-white btn-rounded text-primary font-w600"><i class="fas fa-plus me-1"></i> Nouveau colis</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% if estRepresentant %}
        {# Représentant : colis arrivés dans son pays, à remettre et à encaisser. #}
        {{ m.stat('fas fa-map-marker-alt', 'secondary', parStatut['arrive']|default(0), 'À retirer en agence', path('colis_index', {statut: 'arrive'})) }}
        {{ m.stat('fas fa-hand-holding', 'success', parStatut['recupere']|default(0), 'Remis aux destinataires', path('colis_index', {statut: 'recupere'})) }}
        {{ m.stat('fas fa-wallet', 'success', mesEncaissementsMois.montant|money_local, 'Mes encaissements ce mois-ci', path('encaissement_index')) }}
        {{ m.stat('fas fa-hourglass-half', 'danger', resteAEncaisser|money_local, 'Reste à encaisser', path('colis_index', {paiement: 'non_paye'})) }}
    {% else %}
        {{ m.stat('fas fa-box-open', 'primary', totalColis, estRamassage ? 'Mes colis' : 'Colis au total', path('colis_index', {tous: 1})) }}
        {{ m.stat('fas fa-truck-loading', 'warning', parStatut['en_preparation']|default(0), 'En préparation', path('colis_index', {statut: 'en_preparation'})) }}
        {{ m.stat('fas fa-plane', 'info', (parStatut['expedie']|default(0)) + (parStatut['en_transit']|default(0)) + (parStatut['retenu_douane']|default(0)), 'En route', estRamassage ? path('colis_index', {statut: 'en_transit'}) : path('expedition_index')) }}
        {{ m.stat('fas fa-map-marker-alt', 'secondary', parStatut['arrive']|default(0), 'À retirer en agence', path('colis_index', {statut: 'arrive'})) }}
    {% endif %}

    {% if is_granted('ROLE_ADMIN') %}
        {{ m.stat('fas fa-euro-sign', 'success', totaux.paye|money, 'Encaissé (total)', path('paiement_index')) }}
        {{ m.stat('fas fa-hourglass-half', 'danger', resteAEncaisser|money, 'Reste à encaisser', path('colis_index', {paiement: 'non_paye'})) }}
        {{ m.stat('fas fa-calendar-check', 'primary', totauxMois.paye|money, 'Encaissé ce mois-ci', path('paiement_index')) }}
        {{ m.stat('fas fa-users', 'info', totalClients, 'Clients', path('client_index')) }}
    {% endif %}

    {% if performance %}
    <div class="col-12">
        <div class="card">
            <div class="card-header border-0 pb-0">
                <h4 class="card-title"><i class="fas fa-medal text-warning me-2"></i>Mes performances{% if is_granted('ROLE_ADMIN') %} <small class="text-muted fs-14">(colis que j'ai enregistrés)</small>{% endif %}</h4>
            </div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col-6 col-md-3"><div class="stat-value">{{ performance.mois.nb }}</div><span class="text-muted fs-14">colis ce mois-ci</span></div>
                    <div class="col-6 col-md-3"><div class="stat-value">{{ performance.mois.ca|money }}</div><span class="text-muted fs-14">chiffre d'affaires ce mois-ci</span></div>
                    <div class="col-6 col-md-3">
                        <div class="stat-value">{{ performance.moisPrecedent.nb }}</div>
                        <span class="text-muted fs-14">colis le mois dernier</span>
                        {% if performance.moisPrecedent.nb > 0 %}
                            {% set evolution = ((performance.mois.nb - performance.moisPrecedent.nb) / performance.moisPrecedent.nb * 100)|round %}
                            <div class="fs-13 {{ evolution >= 0 ? 'text-success' : 'text-danger' }}"><i class="fas fa-arrow-{{ evolution >= 0 ? 'up' : 'down' }}"></i> {{ evolution >= 0 ? '+' }}{{ evolution }} % ce mois-ci</div>
                        {% endif %}
                    </div>
                    <div class="col-6 col-md-3"><div class="stat-value">{{ performance.total.nb }}</div><span class="text-muted fs-14">colis au total · {{ performance.total.ca|money }}</span></div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {% if rentabilite %}
    <div class="col-12">
        <div class="card">
            <div class="card-header border-0 pb-0">
                <h4 class="card-title"><i class="fas fa-chart-line text-primary me-2"></i>Rentabilité des expéditions {{ 'now'|date('Y') }}</h4>
                <a href="{{ path('expedition_rentabilite') }}" class="btn btn-primary light btn-sm btn-rounded">Détail</a>
            </div>
            <div class="card-body">
                <div class="row text-center g-3 mb-3">
                    <div class="col-4"><div class="stat-value">{{ rentabilite.ca|money }}</div><span class="text-muted fs-14">chiffre d'affaires</span></div>
                    <div class="col-4"><div class="stat-value text-danger">{{ rentabilite.depenses|money }}</div><span class="text-muted fs-14">charges</span></div>
                    <div class="col-4"><div class="stat-value {{ rentabilite.marge >= 0 ? 'text-success' : 'text-danger' }}">{{ rentabilite.marge >= 0 ? '+' }}{{ rentabilite.marge|money }}</div><span class="text-muted fs-14">marge{% if rentabilite.taux is not null %} · {{ rentabilite.taux|number_format(1, ',', ' ') }} %{% endif %}</span></div>
                </div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>Expédition</th><th class="num">Chiffre d'affaires</th><th class="num">Charges</th><th class="num">Marge</th><th></th></tr></thead>
                        <tbody>
                        {% for l in rentabilite.lignes %}
                            <tr>
                                <td><a href="{{ path('expedition_show', {id: l.expedition.id}) }}#rentabilite" class="text-primary font-w600">{{ l.expedition.numero }}</a> <small class="text-muted">{{ l.expedition.destination.label }} · {{ l.expedition.dateDepart|date('d/m') }}</small></td>
                                <td class="num">{{ l.ca|money }}</td>
                                <td class="num">{{ l.depenses ? l.depenses|money : '—' }}</td>
                                <td class="num font-w600 {{ l.marge >= 0 ? 'text-success' : 'text-danger' }}">{{ l.marge >= 0 ? '+' }}{{ l.marge|money }}</td>
                                <td>{% if not l.depenses %}<span class="badge badge-light">Charges à saisir</span>{% elseif l.marge >= 0 %}<span class="badge badge-success">Gain</span>{% else %}<span class="badge badge-danger">Perte</span>{% endif %}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5"><div class="empty-state"><i class="fas fa-shipping-fast"></i>Aucune expédition cette année.</div></td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {% if performanceAgents %}
    <div class="col-12">
        <div class="card">
            <div class="card-header border-0 pb-0">
                <h4 class="card-title"><i class="fas fa-users text-primary me-2"></i>Performance des agents ce mois-ci</h4>
            </div>
            <div class="card-body pt-2">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>Agent</th><th class="num">Colis</th><th class="num">Chiffre d'affaires</th><th class="num">Déjà encaissé</th></tr></thead>
                        <tbody>
                        {% for a in performanceAgents %}
                            <tr><td class="font-w600">{% if loop.first %}<i class="fas fa-trophy text-warning me-1"></i>{% endif %}{{ a.agent }}</td><td class="num">{{ a.nb }}</td><td class="num">{{ a.ca|money }}</td><td class="num">{{ a.paye|money }}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="col-xl-8">
        <div class="card">
            <div class="card-header border-0 pb-0">
                <h4 class="card-title">Colis reçus par mois</h4>
            </div>
            <div class="card-body">
                <canvas id="chart-mois" height="110" aria-label="Colis reçus par mois" role="img"></canvas>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header border-0 pb-0">
                <h4 class="card-title">Répartition par statut</h4>
            </div>
            <div class="card-body">
                <canvas id="chart-statuts" height="220" aria-label="Répartition des colis par statut" role="img"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card">
            <div class="card-header border-0">
                <h4 class="card-title">{{ estRamassage ? 'Mes derniers colis' : 'Derniers colis' }}</h4>
                <a href="{{ path('colis_index') }}" class="btn btn-primary light btn-sm btn-rounded">Tout voir</a>
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>N° suivi</th><th>Client</th><th>Destinataire</th><th class="num">Reste</th><th>Statut</th></tr></thead>
                        <tbody>
                        {% for c in derniersColis %}
                            <tr>
                                <td><a href="{{ path('colis_show', {id: c.id}) }}" class="text-primary font-w600">{{ c.numeroSuivi }}</a><br><small class="text-muted">{{ c.dateReception|date('d/m/Y') }}</small></td>
                                <td>{{ c.client.nomComplet }}</td>
                                <td>{{ c.destinataireNom }}</td>
                                <td class="num">{{ c.montantRestant|money }}</td>
                                <td>{% include 'partials/_badge.html.twig' with {statut: c.statut} %}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5"><div class="empty-state"><i class="fas fa-box-open"></i>Aucun colis pour le moment.</div></td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        {% if is_granted('ROLE_ADMIN') %}
        <div class="card">
            <div class="card-header border-0">
                <h4 class="card-title">Expéditions récentes</h4>
                <a href="{{ path('expedition_index') }}" class="btn btn-primary light btn-sm btn-rounded">Tout voir</a>
            </div>
            <div class="card-body pt-0">
                {% for e in expeditions %}
                    <a href="{{ path('expedition_show', {id: e.id}) }}" class="d-flex align-items-center justify-content-between py-2 border-bottom text-decoration-none">
                        <span class="d-flex align-items-center gap-3">
                            <span class="stat-icon bgl-primary text-primary" style="width:2.6rem;height:2.6rem;font-size:1rem"><i class="fas {{ e.modeTransport.icone }}"></i></span>
                            <span>
                                <span class="d-block text-black font-w600">{{ e.destination.label }} · {{ e.dateDepart|date('d/m/Y') }}</span>
                                <small class="text-muted">{{ e.numero }} · {{ e.colis|length }} colis</small>
                            </span>
                        </span>
                        {% include 'partials/_badge.html.twig' with {statut: e.statut} %}
                    </a>
                {% else %}
                    <div class="empty-state"><i class="fas fa-shipping-fast"></i>Aucune expédition.</div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {% if ramassages %}
        <div class="card">
            <div class="card-header border-0">
                <h4 class="card-title">Prochains ramassages</h4>
                <a href="{{ path('ramassage_index') }}" class="btn btn-primary light btn-sm btn-rounded">Planning</a>
            </div>
            <div class="card-body pt-0">
                {% for r in ramassages %}
                    <a href="{{ path('ramassage_edit', {id: r.id}) }}" class="d-flex justify-content-between py-2 border-bottom text-decoration-none">
                        <span class="text-black">{{ r.client.nomComplet }}{% if r.statut.value == 'confirme' %} <i class="fas fa-check-circle text-info" title="Confirmé par le client"></i>{% endif %}<br><small class="text-muted">{{ r.client.ville }}</small></span>
                        <span class="text-end text-primary font-w600">{{ r.datePrevue|date('d/m') }}<br><small class="text-muted">{{ r.datePrevue|date('H:i') }}</small></span>
                    </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>

    {% if chartEncaissements.data %}
    <div class="col-12">
        <div class="card">
            <div class="card-header border-0 pb-0">
                <h4 class="card-title">{{ estRepresentant ? 'Mes encaissements' : 'Encaissements' }} des 30 derniers jours ({{ app_devise }})</h4>
            </div>
            <div class="card-body">
                <canvas id="chart-encaissements" height="80" aria-label="Encaissements des 30 derniers jours" role="img"></canvas>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block vendor_javascripts %}
    <script src="{{ asset('theme/vendor/chart.js/Chart.bundle.min.js') }}"></script>
{% endblock %}

{% block javascripts %}
<script nonce="{{ csp_nonce() }}">
(function () {
    const vert = '#00A15D', options = { legend: { display: false }, maintainAspectRatio: true, scales: { yAxes: [{ ticks: { beginAtZero: true, precision: 0 } }], xAxes: [{ gridLines: { display: false } }] } };
    new Chart(document.getElementById('chart-mois'), {
        type: 'bar',
        data: { labels: {{ chartMois.labels|json_encode|raw }}, datasets: [{ label: 'Colis', data: {{ chartMois.data|json_encode|raw }}, backgroundColor: vert, borderRadius: 6, barPercentage: .55 }] },
        options: options
    });
    document.getElementById('chart-encaissements') && new Chart(document.getElementById('chart-encaissements'), {
        type: 'line',
        data: { labels: {{ chartEncaissements.labels|json_encode|raw }}, datasets: [{ label: 'Encaissé', data: {{ chartEncaissements.data|json_encode|raw }}, borderColor: vert, backgroundColor: 'rgba(0,161,93,.12)', pointRadius: 2, lineTension: .35, fill: true }] },
        options: options
    });
    new Chart(document.getElementById('chart-statuts'), {
        type: 'doughnut',
        data: {
            labels: {{ statuts|map(s => s.label)|json_encode|raw }},
            datasets: [{ data: {{ statuts|map(s => parStatut[s.value]|default(0))|json_encode|raw }}, backgroundColor: ['#FFAB2D', '#3e4954', '#58bad7', '#FF5E4B', '#00A15D', '#09BD3C'], borderWidth: 0 }]
        },
        options: { cutoutPercentage: 68, legend: { position: 'bottom', labels: { boxWidth: 12 } } }
    });
})();
</script>
{% endblock %}
