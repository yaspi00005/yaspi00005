{# Compteurs et tableau du registre : rafraîchis automatiquement toutes les 30 s (requête XHR sur appel_index). #}
<div class="row g-2 mb-3">
    <div class="col-6 col-md"><div class="registre-compteur"><strong>{{ compteurs.total }}</strong><span>Total des appels</span></div></div>
    <div class="col-6 col-md"><div class="registre-compteur"><strong class="text-success">{{ compteurs.confirmes }}</strong><span>Confirmés ✅</span></div></div>
    <div class="col-6 col-md"><div class="registre-compteur"><strong class="text-warning">{{ compteurs.attente }}</strong><span>En attente ⏳</span></div></div>
    <div class="col-6 col-md"><div class="registre-compteur"><strong class="text-info">{{ compteurs.aPlanifier }}</strong><span>À planifier 📅</span></div></div>
    <div class="col-6 col-md"><div class="registre-compteur"><strong class="{{ compteurs.sansCamion ? 'text-danger' : 'text-success' }}">{{ compteurs.sansCamion }}</strong><span>Sans camion 🚚</span></div></div>
    <div class="col-6 col-md"><div class="registre-compteur"><strong>{{ compteurs.estimation|money }}</strong><span>Estimations</span></div></div>
</div>
{% macro confirmer(a) %}
    <form method="post" action="{{ path('appel_confirmer', {id: a.id}) }}" class="d-inline">
        <input type="hidden" name="_token" value="{{ csrf_token('confirmer-appel-' ~ a.id) }}">
        <input type="hidden" name="retour" value="{{ app.request.pathInfo }}?{{ app.request.query.all|url_encode }}">
        <button class="btn btn-xs {{ a.confirme ? 'btn-success' : 'btn-outline-danger' }}" title="{{ a.confirme ? 'Cliquer pour remettre en attente' : 'Cliquer pour confirmer' }}">{{ a.confirme ? 'Oui' : 'Non' }}</button>
    </form>
{% endmacro %}
{% macro deplacer(a, sens) %}
    <form method="post" action="{{ path('appel_deplacer', {id: a.id}) }}" class="d-inline js-deplacer-appel">
        <input type="hidden" name="_token" value="{{ csrf_token('deplacer-appel-' ~ a.id) }}">
        <input type="hidden" name="sens" value="{{ sens }}">
        <input type="hidden" name="retour" value="{{ app.request.pathInfo }}?{{ app.request.query.all|url_encode }}">
        <button class="btn btn-light btn-xs" title="{{ sens == 'haut' ? 'Passer avant' : 'Passer après' }}" aria-label="{{ sens == 'haut' ? 'Passer avant' : 'Passer après' }} {{ a.nomComplet }}"><i class="fas fa-arrow-{{ sens == 'haut' ? 'up' : 'down' }}"></i></button>
    </form>
{% endmacro %}
{% macro tri(libelle, cle, filtres, classe = '') %}
    {% set actif = filtres.tri == cle %}
    {% set sens = actif and filtres.sens == 'asc' ? 'desc' : 'asc' %}
    <th class="{{ classe }}"><a href="?{{ app.request.query.all|merge({tri: cle, sens: sens, page: null})|filter(v => v is not null)|url_encode }}" class="lien-tri{{ actif ? ' actif' }}" title="Trier par {{ libelle|lower }}">{{ libelle }} <i class="fas fa-{{ actif ? (filtres.sens == 'asc' ? 'sort-up' : 'sort-down') : 'sort' }}"></i></a></th>
{% endmacro %}
{% macro traiter(a) %}
    {% set archive = a.archive %}
    <form method="post" action="{{ path('appel_traiter', {id: a.id}) }}" class="d-inline js-traiter-appel"
          data-confirm="{{ archive ? 'L\'appel de ' ~ a.nomComplet ~ ' reviendra dans la liste des appels en cours.' : 'L\'appel de ' ~ a.nomComplet ~ ' disparaîtra de la liste et passera aux Archives.' ~ (a.ramassage ? ' Son ramassage sera marqué effectué.' : '') }}"
          data-confirm-titre="{{ archive ? 'Remettre en cours ?' : 'Marquer comme traité ?' }}" data-confirm-type="{{ archive ? 'warning' : 'primary' }}" data-confirm-bouton="{{ archive ? 'Remettre en cours' : 'Oui, traité' }}">
        <input type="hidden" name="_token" value="{{ csrf_token('traiter-appel-' ~ a.id) }}">
        <input type="hidden" name="retour" value="{{ app.request.pathInfo }}?{{ app.request.query.all|url_encode }}">
        {% if archive %}
            <button class="btn btn-outline-warning btn-xs text-nowrap" title="Remettre cet appel dans la liste"><i class="fas fa-undo me-1"></i>Remettre en cours</button>
        {% else %}
            <button class="btn btn-outline-success btn-xs text-nowrap" title="Appel traité : il passe aux Archives"><i class="fas fa-check me-1"></i>Traité</button>
        {% endif %}
    </form>
{% endmacro %}
{% import _self as m %}
{# Camion choisi : ordre de passage, modifiable avec les flèches (repris dans le PDF du camion). #}
{% set tournee = filtres.camion and filtres.vue != 'archives' and not filtres.tri %}
{% if tournee %}<p class="text-muted small mb-2"><i class="fas fa-route me-1"></i> Ordre de passage du camion : utilisez les flèches ↑ ↓ pour le modifier. Il est repris dans le PDF du camion.</p>
{% elseif filtres.camion and filtres.tri %}<p class="text-muted small mb-2"><i class="fas fa-sort me-1"></i> Liste triée par colonne. <a href="?{{ app.request.query.all|merge({tri: null, sens: null, page: null})|filter(v => v is not null)|url_encode }}">Revenir à l'ordre de passage du camion</a> pour le modifier.</p>{% endif %}
{# Téléphone : une fiche par appel (le tableau serait trop large). #}
<div class="d-md-none">
    {% for a in appels %}
        {% set etat = a.etat %}
        <div class="registre-fiche {{ a.confirme ? '' : 'non-confirme' }}">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <a href="{{ path('appel_edit', {id: a.id}) }}" class="font-w600 text-black">{{ a.nomComplet }}</a>
                {{ m.confirmer(a) }}
            </div>
            <a href="tel:{{ a.telephone|replace({' ': ''}) }}" class="d-block"><i class="fas fa-phone-alt me-1"></i>{{ a.telephone|tel }}</a>
            <small class="d-block text-muted">{{ a.adresse ? a.adresse ~ ', ' }}{{ a.codePostal }} {{ a.ville }}</small>
            <small class="d-block mt-1">
                {% if a.camion %}<span class="pastille-camion" style="background: {{ a.camion.couleur }}"></span>{{ a.camion.nom }} · {% endif %}
                {% if a.dateConteneurPrevue %}📦 {{ a.dateConteneurPrevue|date('d/m') }} · {% endif %}
                {% if tournee %}<strong>N° {{ appels.premier + loop.index0 }}</strong> · {% endif %}
                {% if a.estimation is not null %}{{ a.estimation|money }} · {% endif %}
                <span class="badge badge-{{ etat[1] }} light">{{ etat[0] }}</span>
            </small>
            {% if a.commentaire %}<small class="d-block text-muted mt-1">{{ a.commentaire|u.truncate(100, '…') }}</small>{% endif %}
            <div class="mt-2">{{ m.traiter(a) }}</div>
            {% if tournee %}<div class="mt-1">{% if not loop.first or appels.page > 1 %}{{ m.deplacer(a, 'haut') }}{% endif %}{% if not loop.last or appels.aSuivante %}{{ m.deplacer(a, 'bas') }}{% endif %}</div>{% endif %}
        </div>
    {% else %}
        <div class="empty-state"><i class="fas fa-phone-alt"></i>Aucun appel.</div>
    {% endfor %}
</div>
<div class="table-responsive d-none d-md-block">
    <table class="table table-hover registre-table mb-0">
        <thead>
            <tr>{% if tournee %}<th>N°</th>{% endif %}
                {{ m.tri('Date appel', 'date', filtres) }}{{ m.tri('Conteneur', 'conteneur', filtres) }}{{ m.tri('Camion', 'camion', filtres) }}{{ m.tri('Nom', 'nom', filtres) }}
                {{ m.tri('Téléphone', 'telephone', filtres) }}{{ m.tri('CP', 'cp', filtres) }}{{ m.tri('Ville', 'ville', filtres) }}{{ m.tri('Adresse', 'adresse', filtres) }}
                {{ m.tri('Estimation', 'estimation', filtres, 'num') }}{{ m.tri('Utilisateur', 'utilisateur', filtres) }}{{ m.tri('Confirmé', 'confirme', filtres) }}<th>Ramassage</th><th>Commentaire</th><th></th></tr>
        </thead>
        <tbody>
        {% for a in appels %}
            {% set etat = a.etat %}
            <tr class="{{ a.confirme ? '' : 'non-confirme' }}">
                {% if tournee %}<td class="text-nowrap"><strong class="me-1">{{ appels.premier + loop.index0 }}</strong>{% if not loop.first or appels.page > 1 %}{{ m.deplacer(a, 'haut') }}{% endif %}{% if not loop.last or appels.aSuivante %}{{ m.deplacer(a, 'bas') }}{% endif %}</td>{% endif %}
                <td>{{ a.dateAppel|date('d/m/Y') }}{% if a.source == 'site' %} <span class="badge badge-primary light" title="Demande faite sur sotrama.net">Site</span>{% endif %}</td>
                <td>{{ a.dateConteneurPrevue ? a.dateConteneurPrevue|date('d/m/Y') : '—' }}</td>
                <td>{% if a.camion %}<span class="pastille-camion" style="background: {{ a.camion.couleur }}"></span>{{ a.camion.nom }}{% else %}<span class="text-muted">—</span>{% endif %}</td>
                <td class="font-w600"><a href="{{ path('appel_edit', {id: a.id}) }}" class="text-black">{{ a.nomComplet }}</a></td>
                <td><a href="tel:{{ a.telephone|replace({' ': ''}) }}">{{ a.telephone|tel }}</a></td>
                <td>{{ a.codePostal }}</td>
                <td>{{ a.ville }}</td>
                <td>{{ a.adresse ?: '—' }}</td>
                <td class="num">{{ a.estimation is not null ? a.estimation|money : '—' }}</td>
                <td>{{ a.utilisateur ? a.utilisateur.prenom : (a.source == 'site' ? 'Site web' : '—') }}</td>
                <td>{{ m.confirmer(a) }}</td>
                <td>{% if a.ramassage %}<a href="{{ path('ramassage_edit', {id: a.ramassage.id}) }}" class="badge badge-{{ etat[1] }} light">{{ etat[0] }}</a>{% else %}<span class="badge badge-{{ etat[1] }} light">{{ etat[0] }}</span>{% endif %}</td>
                <td class="registre-commentaire">{{ a.commentaire|u.truncate(120, '…') }}</td>
                <td class="text-end text-nowrap">{{ m.traiter(a) }} <a href="{{ path('appel_edit', {id: a.id}) }}" class="btn btn-primary shadow btn-xs sharp" title="Modifier" aria-label="Modifier l'appel de {{ a.nomComplet }}"><i class="fas fa-pencil-alt"></i></a></td>
            </tr>
        {% else %}
            <tr><td colspan="15"><div class="empty-state"><i class="fas fa-phone-alt"></i>Aucun appel{{ filtres.q or filtres.vue != 'tous' or filtres.camion or filtres.chauffeur or filtres.expedition ? ' pour ces critères' }}.</div></td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% include 'partials/_pagination.html.twig' with {pagination: appels} %}
<p class="registre-synchro mt-2 mb-0">Dernière synchro : <span class="js-synchro">{{ synchro|date('H:i:s') }}</span></p>
