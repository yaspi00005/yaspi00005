{# Formulaire d'un appel (nouveau ou modification). Paramètres : form, bouton #}
{{ form_start(form, {attr: {'data-villes-url': path('client_villes'), 'data-client-url': path('appel_client'), class: 'js-form-appel'}}) }}
<input type="hidden" class="js-cp-pays" value="France">
<datalist id="villes-cp"></datalist>
<div class="row">
    <div class="col-md-4">{{ form_row(form.dateAppel) }}</div>
    <div class="col-md-4">{{ form_row(form.camion) }}</div>
    <div class="col-md-4">{{ form_row(form.expedition) }}</div>
</div>
<div class="row align-items-start">
    <div class="col-12 mb-2">{{ form_row(form.modeClient) }}</div>
    {# Client de la base : recherche par nom ou téléphone, coordonnées reprises (modifiables pour l'adresse du ramassage). #}
    <div class="col-xl-8 js-bloc-existant">{{ form_row(form.client) }}</div>
    {# Nouveau client : sa fiche est créée à l'enregistrement. #}
    <div class="col-md-6 col-xl-4 js-bloc-nouveau">{{ form_row(form.nom) }}</div>
    <div class="col-md-6 col-xl-4 js-bloc-nouveau">{{ form_row(form.prenom) }}</div>
    <div class="col-md-6 col-xl-4">{{ form_row(form.telephone) }}<div class="client-connu text-success d-none js-client-connu"></div></div>
</div>
<div class="row">
    <div class="col-md-4 col-xl-2">{{ form_row(form.codePostal) }}</div>
    <div class="col-md-8 col-xl-3">{{ form_row(form.ville) }}</div>
    <div class="col-md-8 col-xl-5">{{ form_row(form.adresse) }}</div>
    <div class="col-md-4 col-xl-2">{{ form_row(form.estimation) }}</div>
</div>
<div class="row">
    <div class="col-xl-6">{{ form_row(form.commentaire) }}</div>
    <div class="col-md-6 col-xl-3">{{ form_row(form.dateRamassage) }}</div>
    <div class="col-md-6 col-xl-3 d-flex flex-column justify-content-end">
        <div class="mb-3">{{ form_row(form.confirme) }}</div>
        <button class="btn btn-primary w-100 mb-3"><i class="fas fa-save me-1"></i> {{ bouton }}</button>
    </div>
</div>
{{ form_rest(form) }}
{{ form_end(form) }}
