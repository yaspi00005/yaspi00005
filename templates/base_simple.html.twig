<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_nom }}{% endblock %}</title>
    <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
    <meta name="theme-color" content="#00A15D">
    <link rel="apple-touch-icon" href="{{ asset('images/app/apple-touch-icon.png') }}">
    <link rel="shortcut icon" type="image/png" href="{{ logo_existe() ? asset('images/logo-sotrama.png') : asset('theme/images/favicon.png') }}">
    <link href="{{ asset('theme/css/style.css') }}" rel="stylesheet">
    <link href="{{ asset('css/sotrama.css') }}" rel="stylesheet">
</head>
<body class="vh-100">
    <div class="authincation h-100">
        <div class="container h-100">
            <div class="row justify-content-center h-100 align-items-center">
                <div class="{% block colonne %}col-md-6 col-lg-5{% endblock %}">
                    <div class="authincation-content">
                        <div class="auth-form">
                            <div class="text-center mb-4">
                                {% if logo_existe() %}
                                <a href="{{ path('app_accueil') }}" class="d-inline-block text-decoration-none">
                                    <img src="{{ asset('images/logo-sotrama.png') }}" alt="SOTRAMA" class="logo-connexion">
                                    <span class="d-block fs-13 text-muted mt-2">Gestion des marchandises</span>
                                </a>
                                {% else %}
                                <a href="{{ path('app_accueil') }}" class="d-inline-flex align-items-center gap-3 text-decoration-none">
                                    {% include 'partials/_logo.html.twig' %}
                                    <span class="text-start">
                                        <span class="d-block fs-24 font-w700 text-black">SOTRAMA</span>
                                        <span class="d-block fs-13 text-muted">Gestion des marchandises</span>
                                    </span>
                                </a>
                                {% endif %}
                            </div>
                            {% block body %}{% endblock %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ asset('theme/vendor/global/global.min.js') }}"></script>
</body>
</html>
